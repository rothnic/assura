{
  "schema": "assura.agent-integration-manifest.v1",
  "assura_version": "0.4.1",
  "minimum_assura_version": "0.4.1",
  "adapter_contract_version": 1,
  "adapter_version": "0.4.1",
  "managed_marker": "Generated by Assura agent integration lifecycle",
  "managed_by": "assura",
  "target_agent": "codex",
  "lifecycle_commands": {
    "install": "assura agent integration install codex .",
    "activate": "assura agent integration activate codex .",
    "update": "assura agent integration update codex .",
    "deactivate": "assura agent integration deactivate codex .",
    "remove": "assura agent integration remove codex .",
    "status": "assura agent integration status codex .",
    "doctor": "assura agent integration doctor codex ."
  },
  "shared_commands": {
    "nudge": "assura agent nudge --agent codex --event <event> --changed <path> --delivery automatic --format json .",
    "check": "assura check --format agent --agent codex --warn .",
    "daemon_status": "assura daemon status --format json .",
    "daemon_doctor": "assura daemon doctor --format json ."
  },
  "event_placements": [
    {
      "event": "session-start",
      "placement": "session start or resumed session"
    },
    {
      "event": "before-tool",
      "placement": "before path-aware edit, move, delete, or shell tool calls"
    },
    {
      "event": "after-tool",
      "placement": "after writes or commands that may change project state"
    },
    {
      "event": "file-read",
      "placement": "before or after high-value file reads"
    },
    {
      "event": "idle",
      "placement": "when a session goes idle or a periodic agent review runs"
    },
    {
      "event": "recovery",
      "placement": "after failed tools, stale daemon state, or context recovery"
    }
  ],
  "event_mappings": [
    {
      "host_event": "SessionStart",
      "assura_event": "session-start",
      "delivery": "model-context"
    },
    {
      "host_event": "UserPromptSubmit",
      "assura_event": "idle",
      "delivery": "model-context"
    },
    {
      "host_event": "PreToolUse",
      "assura_event": "before-tool",
      "delivery": "model-context"
    },
    {
      "host_event": "PostToolUse",
      "assura_event": "after-tool",
      "delivery": "model-context"
    }
  ],
  "unsupported_events": [
    "file-read",
    "recovery"
  ],
  "managed_files": [
    {
      "path": ".assura/integrations/codex/assura-agent.sh",
      "kind": "wrapper",
      "sha256": "9ecf16bf4c9a5aa51db30fa7e59c5bcb03457c0602302487599b002fd4c994f0",
      "executable": true,
      "host_activation": false
    },
    {
      "path": ".assura/integrations/codex/README.md",
      "kind": "readme",
      "sha256": "ae1555147ca2cb2d3ff72aa409d994c241c6addb18e6e9ce75e2e52500f481b4",
      "executable": false,
      "host_activation": false
    },
    {
      "path": ".assura/integrations/codex/assura-hook.py",
      "kind": "host_adapter",
      "sha256": "fa9fde865cd68b3f46eabf0738797445e3b2a048e49228a467b28f210a7f59d1",
      "executable": false,
      "host_activation": false
    }
  ],
  "logging": {
    "enabled_by_default": true,
    "log_file": ".assura/agent-sessions/nudges.jsonl",
    "disable": "ASSURA_AGENT_LOG=0",
    "session_id": "ASSURA_AGENT_SESSION_ID"
  },
  "runtime": {
    "adapter_runtime": "python3",
    "host_contract": "project hooks.json command hooks",
    "host_approval_required": true,
    "verification_scope": "managed files and project configuration",
    "update_channel": "assura agent integration update codex"
  },
  "host": {
    "install_mode": "managed-project-lifecycle",
    "host_config_status": "explicit-activation",
    "config_hint": "Run `assura agent integration activate codex .`; then trust the project and approve its hooks in Codex.",
    "fallback": "Run assura check --format agent --agent codex --warn for prompt-level feedback."
  }
}
