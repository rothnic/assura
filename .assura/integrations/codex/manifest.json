{
  "schema": "assura.agent-integration-manifest.v1",
  "managed_marker": "Generated by Assura agent integration lifecycle",
  "managed_by": "assura",
  "target_agent": "codex",
  "lifecycle_commands": {
    "install": "assura agent integration install codex .",
    "update": "assura agent integration update codex .",
    "remove": "assura agent integration remove codex .",
    "status": "assura agent integration status codex .",
    "doctor": "assura agent integration doctor codex ."
  },
  "shared_commands": {
    "nudge": "assura agent nudge --agent codex --event <event> --changed <path> --format json .",
    "check": "assura check --format agent --agent codex --warn .",
    "daemon_status": "assura daemon status --format json .",
    "daemon_doctor": "assura daemon doctor --format json ."
  },
  "event_placements": [
    {
      "event": "session-start",
      "placement": "session start or resumed session"
    },
    {
      "event": "before-tool",
      "placement": "before path-aware edit, move, delete, or shell tool calls"
    },
    {
      "event": "after-tool",
      "placement": "after writes or commands that may change project state"
    },
    {
      "event": "file-read",
      "placement": "before or after high-value file reads"
    },
    {
      "event": "idle",
      "placement": "when a session goes idle or a periodic agent review runs"
    },
    {
      "event": "recovery",
      "placement": "after failed tools, stale daemon state, or context recovery"
    }
  ],
  "files": [
    "manifest.json",
    "assura-agent.sh",
    "README.md"
  ],
  "logging": {
    "enabled_by_default": true,
    "log_file": ".assura/agent-sessions/nudges.jsonl",
    "disable": "ASSURA_AGENT_LOG=0",
    "session_id": "ASSURA_AGENT_SESSION_ID"
  },
  "host": {
    "install_mode": "reviewable-local-bundle",
    "host_config_status": "manual-opt-in",
    "config_hint": "Wire .assura/integrations/codex/assura-agent.sh or .codex/hooks/assura-agent-nudge.py from approved Codex UserPromptSubmit and PostToolUse hooks.",
    "fallback": "Run assura check --format agent --agent codex --warn for prompt-level feedback."
  }
}
