#!/bin/sh
# Assura pre-commit hook
# Runs validation before allowing a commit
# Blocks commits on main branch, warns on other branches

set -e

# Find the project root (directory containing .assura)
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
ASSURA_DIR="$PROJECT_ROOT/.assura"

if [ ! -d "$ASSURA_DIR" ]; then
    echo "Error: .assura directory not found. Run 'assura init' first."
    exit 1
fi

# Get current branch name (handle empty repo case)
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# Skip branch-based enforcement for initial commit
if [ "$BRANCH" = "HEAD" ]; then
    echo "Initial commit detected - skipping branch-based enforcement"
    BRANCH="initial"
fi

echo "Running Assura pre-commit validation on branch: $BRANCH..."

run_assura() {
    if command -v assura >/dev/null 2>&1; then
        assura "$@"
    elif [ -x "$PROJECT_ROOT/target/debug/assura" ]; then
        "$PROJECT_ROOT/target/debug/assura" "$@"
    elif command -v cargo >/dev/null 2>&1; then
        (cd "$PROJECT_ROOT" && cargo run --quiet -- "$@")
    else
        return 127
    fi
}

# Check if assura is available
if run_assura --help >/dev/null 2>&1; then
    # Run assura check and capture output
    if run_assura check "$PROJECT_ROOT" --format advice 2>&1; then
        echo "✓ Assura validation passed"
        exit 0
    else
        EXIT_CODE=$?
        if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "ERROR: Assura validation failed on $BRANCH branch"
            echo ""
            echo "Commits to main/master are blocked until all"
            echo "validation issues are resolved."
            echo ""
            echo "Please fix the issues above or commit to a"
            echo "feature branch instead."
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            exit $EXIT_CODE
        else
            echo ""
            echo "⚠ WARNING: Assura validation found issues"
            echo ""
            echo "Branch '$BRANCH' allows commits with warnings."
            echo "Please consider fixing these issues before merging."
            echo ""
            # Don't block the commit on non-main branches
            exit 0
        fi
    fi
else
    echo "Warning: assura command not found and local cargo fallback is unavailable"
    echo "Skipping Assura validation"
    exit 0
fi
