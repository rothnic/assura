#!/bin/sh
# Assura pre-push hook
# Delegates validation to Assura's stable pre-push runner.

set -e

echo "Running Assura pre-push validation..."

# Find the project root
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
ASSURA_DIR="$PROJECT_ROOT/.assura"

if [ ! -d "$ASSURA_DIR" ]; then
    echo "Warning: .assura directory not found"
    exit 0
fi

run_assura() {
    if command -v assura >/dev/null 2>&1; then
        assura "$@"
    elif [ -x "$PROJECT_ROOT/target/debug/assura" ]; then
        "$PROJECT_ROOT/target/debug/assura" "$@"
    elif command -v cargo >/dev/null 2>&1; then
        (cd "$PROJECT_ROOT" && cargo run --quiet -- "$@")
    else
        return 127
    fi
}

# The CLI runner owns advisory and ASSURA_BLOCKING_PUSH behavior so generated
# Git hooks and pre-commit invoke one contract.
if run_assura --help >/dev/null 2>&1; then
    run_assura hooks run pre-push
else
    echo "Warning: assura command not found and local cargo fallback is unavailable"
    exit 0
fi
