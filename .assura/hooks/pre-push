#!/bin/sh
# Assura pre-push hook
# Runs full validation before pushing

set -e

echo "Running Assura pre-push validation..."

# Find the project root
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
ASSURA_DIR="$PROJECT_ROOT/.assura"

if [ ! -d "$ASSURA_DIR" ]; then
    echo "Warning: .assura directory not found"
    exit 0
fi

run_assura() {
    if command -v assura >/dev/null 2>&1; then
        assura "$@"
    elif [ -x "$PROJECT_ROOT/target/debug/assura" ]; then
        "$PROJECT_ROOT/target/debug/assura" "$@"
    elif command -v cargo >/dev/null 2>&1; then
        (cd "$PROJECT_ROOT" && cargo run --quiet -- "$@")
    else
        return 127
    fi
}

# Run full validation. This stays advisory until the repository passes its
# self-check baseline; set ASSURA_BLOCKING_PUSH=1 to opt into local blocking.
if run_assura --help >/dev/null 2>&1; then
    if run_assura check "$PROJECT_ROOT" --format advice; then
        echo "Assura validation passed"
        exit 0
    else
        EXIT_CODE=$?
    fi

    if [ "$ASSURA_BLOCKING_PUSH" = "1" ]; then
        echo "ERROR: Assura validation failed and ASSURA_BLOCKING_PUSH=1 is set"
        exit $EXIT_CODE
    fi

    echo ""
    echo "WARNING: Assura validation found issues"
    echo "Pre-push is advisory until the self-check baseline is clean."
    echo "Set ASSURA_BLOCKING_PUSH=1 to enforce blocking pushes locally."
    exit 0
else
    echo "Warning: assura command not found and local cargo fallback is unavailable"
    exit 0
fi
