---
import AgentSetupDialog from './agent-setup-dialog.astro';
import MarketingLayout from './marketing-layout.astro';
import TerminalCard from './terminal-card.astro';
import {
  agentSetupPrompt,
  agentSetupSteps,
  installCommand,
  marketingNav,
  onboardingCommand,
  checkCommand,
  reviewCommand,
  releaseScope,
  releaseStatus,
  verificationCommand,
} from '../../data/marketing';

interface Item {
  label: string;
  body: string;
}

interface LinkItem {
  label: string;
  href: string;
}

interface ArtifactLine {
  text: string;
  tone?: string;
}

type ArtifactTone = 'prompt' | 'plain' | 'muted' | 'info' | 'warn' | 'pass' | 'fail';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  imagePath: string;
  eyebrow: string;
  heading: string;
  intro: string;
  artifactTitle: string;
  artifactLines: Array<string | ArtifactLine>;
  artifactProvenance: 'generated-cli' | 'authored' | 'historical-performance';
  artifactSourceRevision?: string;
  artifactKind?: 'review' | 'check' | 'onboarding' | 'neutral';
  highlights: Item[];
  sections: Item[];
  docsLinks: LinkItem[];
  adjacentLinks: LinkItem[];
  releaseSurface?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const props = Astro.props;
const setupHref = props.canonicalPath === '/' ? '#onboard' : '/#onboard';
const artifactTones = new Set<ArtifactTone>(['prompt', 'plain', 'muted', 'info', 'warn', 'pass', 'fail']);
const artifactLines = props.artifactLines.map((line) => {
  if (typeof line === 'string') return { text: line, tone: 'plain' as const };
  const tone = artifactTones.has(line.tone as ArtifactTone) ? line.tone as ArtifactTone : 'plain';
  return { text: line.text, tone };
});
const qualifiedCommand = props.artifactKind === 'review'
  ? reviewCommand
  : props.artifactKind === 'check'
    ? checkCommand
    : props.artifactKind === 'onboarding'
      ? onboardingCommand
      : undefined;
---

<MarketingLayout
  title={props.title}
  description={props.description}
  canonicalPath={props.canonicalPath}
  imagePath={props.imagePath}
  navItems={marketingNav}
  {setupHref}
  structuredData={props.structuredData}
>
  <main id="main-content" class="focused-page" data-release-surface={props.releaseSurface}>
    <section class="focused-hero" aria-labelledby="focused-title">
      <div class="focused-hero-copy">
        <p class="eyebrow">{props.eyebrow}</p>
        <h1 id="focused-title">{props.heading}</h1>
        <p>{props.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={setupHref} data-open-setup data-analytics-event="setup_open">
            Start with your agent
          </a>
          <a class="button button-secondary surface" href={props.docsLinks[0].href} data-analytics-event="docs_click">
            {props.docsLinks[0].label}
          </a>
        </div>
      </div>
      <div class="focused-evidence-example">
        {props.artifactProvenance === 'generated-cli' ? <div class="release-route-status">
          <strong>Recorded source example</strong>
          <span>CLI, generator and fixture input revision: <code>{props.artifactSourceRevision ?? 'unavailable'}</code>.</span>
          <small>Source checkout output; published release output may differ.</small>
          {qualifiedCommand && <code>{qualifiedCommand}</code>}
          <small>Example output below preserves the raw generated CLI evidence.</small>
        </div> : <p class="artifact-provenance">
          {props.artifactProvenance === 'historical-performance'
            ? 'Historical performance summary; not raw CLI output.'
            : 'Authored summary; not raw CLI output.'}
        </p>}
        <TerminalCard
          title={props.artifactTitle}
          lines={artifactLines}
          className="focused-artifact"
          variant={props.artifactKind ?? 'neutral'}
        />
      </div>
    </section>

    <section class="focused-band" aria-label="Key points">
      {props.highlights.map((item) => (
        <article>
          <h2>{item.label}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </section>

    <section class="focused-content" aria-label="Details">
      {props.sections.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2>{item.label}</h2>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="focused-links" aria-labelledby="next-title">
      <div>
        <p class="eyebrow">Continue</p>
        <h2 id="next-title">Follow the signal into the details.</h2>
      </div>
      <nav aria-label="Related product and documentation pages">
        {[...props.adjacentLinks, ...props.docsLinks].map((item) => (
          <a href={item.href} data-analytics-event={item.href.includes('/guides/') || item.href.includes('/reference/') ? 'docs_click' : 'related_page_click'}>
            {item.label}<span aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </section>
  </main>
  <AgentSetupDialog
    steps={agentSetupSteps}
    prompt={agentSetupPrompt}
    onboardingCommand={onboardingCommand}
    installCommand={installCommand}
    releaseStatus={releaseStatus}
    releaseScope={releaseScope}
    verificationCommand={verificationCommand}
  />
</MarketingLayout>

<style>
  .focused-evidence-example, .release-route-status { display: grid; gap: 0.75rem; min-width: 0; }
  .release-route-status { color: var(--muted); line-height: 1.45; }
  .release-route-status strong { color: var(--text); }
  .release-route-status code { overflow-wrap: anywhere; color: var(--text); }
  .release-route-status small { color: var(--soft); }
  .artifact-provenance { margin: 0; color: var(--muted); line-height: 1.45; }
</style>
