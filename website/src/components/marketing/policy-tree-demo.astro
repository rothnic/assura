---
import projectContract from '../../data/config-examples/agentic-monorepo.yml?raw';

const markers = new Map([
  ['AGENTS.md: exists:1 | $agent-entrypoint', '1'],
  ['./*: $closed-entry', '2'],
  ['.md: kebab-case | exact:AGENTS | exact:README', '3'],
  ['.{md,js,jsx,ts,tsx}: max_lines:500 | severity:low', '4'],
]);

const splitYamlLine = (text: string) => {
  const content = text.trimStart();
  const indent = text.slice(0, text.length - content.length);
  let quote: '"' | "'" | null = null;

  for (let index = 0; index < content.length; index += 1) {
    const character = content[index];
    if (quote) {
      if (character === quote && content[index - 1] !== '\\') quote = null;
      continue;
    }
    if (character === '"' || character === "'") {
      quote = character;
      continue;
    }
    if (character === ':') {
      return {
        indent,
        key: content.slice(0, index),
        value: content.slice(index + 1),
      };
    }
  }

  return { indent, key: null, value: content };
};

const configLines = projectContract.trimEnd().split('\n').map((text) => {
  const trimmed = text.trim();
  return {
    ...splitYamlLine(text),
    marker: markers.get(trimmed),
  };
});
---

<div class="policy-tree-demo">
  <section class="policy-panel" aria-labelledby="policy-config-title">
    <header>
      <span>Project contract</span>
      <h3 id="policy-config-title">.assura/config.yml</h3>
    </header>
    <pre tabindex="0"><code>{configLines.map((line) => (
      <span class="config-line"><span class="config-content"><span>{line.indent}</span>{line.key === null ? <span class="config-value">{line.value}</span> : <><span class="config-key">{line.key}</span><span class="config-separator">:</span><span class="config-value">{line.value}</span></>}</span>{line.marker && <i class="rule-marker" aria-label={`Rule ${line.marker}`}>{line.marker}</i>}</span>
    ))}</code></pre>
  </section>

  <section class="tree-panel" aria-labelledby="policy-tree-title">
    <header>
      <span>Same rules, applied</span>
      <h3 id="policy-tree-title">Project tree</h3>
    </header>
    <ul class="tree-root">
      <li>
        <div class="tree-row neutral">
          <span class="tree-status" aria-label="Project scope">·</span>
          <code>project/</code><small>top-down policy</small>
        </div>
        <ul>
          <li><div class="tree-row pass"><span class="tree-status" aria-label="Pass">✓</span><code>AGENTS.md</code><small><i class="rule-marker">1</i> required file</small></div></li>
          <li>
            <div class="tree-row neutral"><span class="tree-status" aria-label="Configured scope">·</span><code>packages/core/</code><small>workspace contract</small></div>
            <ul>
              <li><div class="tree-row pass"><span class="tree-status" aria-label="Pass">✓</span><code>AGENTS.md</code><small><i class="rule-marker">1</i> required guidance</small></div></li>
              <li><div class="tree-row pass"><span class="tree-status" aria-label="Pass">✓</span><code>package.json</code><small>required manifest</small></div></li>
              <li>
                <div class="tree-row neutral"><span class="tree-status" aria-label="Configured scope">·</span><code>src/</code><small>recursive defaults</small></div>
                <ul>
                  <li><div class="tree-row pass"><span class="tree-status" aria-label="Pass">✓</span><code>user-menu.tsx</code><small><i class="rule-marker">4</i> 184 / 500 lines</small></div></li>
                  <li><div class="tree-row fail"><span class="tree-status" aria-label="Blocking violation">!</span><code>BadName.tsx</code><small><i class="rule-marker">3</i> expected kebab-case</small></div></li>
                  <li><div class="tree-row warn"><span class="tree-status" aria-label="Advisory warning">!</span><code>checkout-flow.tsx</code><small><i class="rule-marker">4</i> 537 / 500 lines</small></div></li>
                </ul>
              </li>
            </ul>
          </li>
          <li>
            <div class="tree-row neutral"><span class="tree-status" aria-label="Configured scope">·</span><code>.agents/skills/release-check/</code><small>strict skill root</small></div>
            <ul>
              <li><div class="tree-row pass"><span class="tree-status" aria-label="Pass">✓</span><code>SKILL.md</code><small>required entrypoint</small></div></li>
              <li><div class="tree-row fail"><span class="tree-status" aria-label="Blocking violation">!</span><code>notes.md</code><small><i class="rule-marker">2</i> undeclared entry</small></div></li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
    <footer>
      <span><i class="legend-dot pass"></i> passes</span>
      <span><i class="legend-dot warn"></i> advisory</span>
      <span><i class="legend-dot fail"></i> blocking</span>
    </footer>
  </section>
</div>
