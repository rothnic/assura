---
import assuraPolicy from '../../data/config-examples/agentic-monorepo.yml?raw';

type CodeLine = {
  indent?: number;
  key?: string;
  value?: string;
  comment?: string;
  tone?: 'section' | 'scope' | 'definition' | 'directive' | 'required' | 'optional' | 'limit';
};

const toneFor = (key: string, value?: string): CodeLine['tone'] => {
  if (key === 'rules' || key === 'structure') return 'section';
  if (key.includes('/') || key === './') return 'scope';
  if (key.includes('@package-standard') || value?.includes('@package-standard')) return 'definition';
  if (key === 'max_lines') return 'limit';
  if (value === 'true' || value === '1' || value === 'exists:1') return 'required';
  if (value === 'false' || value === '0-1' || value === 'exists:0-1') return 'optional';
  return 'directive';
};

const assuraLines: CodeLine[] = assuraPolicy.trimEnd().split('\n').map((text) => {
  if (!text.trim()) return {};
  const indent = Math.floor((text.length - text.trimStart().length) / 2);
  const content = text.trim();
  const separator = content.indexOf(':');
  const key = separator === -1 ? content : content.slice(0, separator);
  const value = separator === -1 ? undefined : content.slice(separator + 1).trim() || undefined;
  return { indent, key, value, tone: toneFor(key, value) };
});

const lsLintLines: CodeLine[] = [
  { comment: 'Closest shared naming coverage.' },
  { key: 'ls', tone: 'section' },
  { indent: 1, key: 'packages', tone: 'scope' },
  { indent: 2, key: '.dir', value: 'kebab-case', tone: 'directive' },
  {},
  { indent: 1, key: 'packages/*', tone: 'scope' },
  { indent: 2, key: '.md', value: 'regex:^(AGENTS|README)$', tone: 'directive' },
  { indent: 2, key: '.json', value: 'regex:^(package|tsconfig)$', tone: 'directive' },
  { indent: 2, key: 'src', tone: 'scope' },
  { indent: 3, key: '.ts', value: 'kebab-case', tone: 'directive' },
  { indent: 2, key: 'tests', tone: 'scope' },
  { indent: 3, key: '.test.ts', value: 'kebab-case', tone: 'directive' },
];
---

<article class="policy-breadth-card" id="monorepo-policy">
  <header class="policy-breadth-head">
    <div>
      <span>Agentic monorepo policy</span>
      <h3>One contract for every package.</h3>
      <p>
        The packages directory is optional. Once it exists, every matching package receives the same
        required guidance, manifest, naming, and size policy.
      </p>
    </div>
    <strong>Quality policy example</strong>
  </header>

  <section class="policy-scope-summary" aria-labelledby="policy-shape-title">
    <header>
      <span>Expected shape</span>
      <h4 id="policy-shape-title">Two scopes, one clear inheritance path.</h4>
    </header>
    <div class="policy-scope-grid">
      <div class="policy-scope is-root">
        <div><strong>Project root</strong><span>Always checked</span></div>
        <ul>
          <li><code>AGENTS.md</code> required by <code>@agentic-project</code></li>
          <li><code>package.json</code> required</li>
          <li>Root <code>AGENTS.md</code> capped at 300 lines</li>
        </ul>
      </div>
      <div class="policy-scope is-package">
        <div><strong><code>{'packages/{package}/'}</code></strong><span>When present</span></div>
        <ul>
          <li><code>AGENTS.md</code>, <code>package.json</code>, and <code>src/</code> required</li>
          <li><code>README.md</code>, tests, fixtures, and config optional</li>
          <li>Guidance, docs, and TypeScript capped at 200 lines</li>
        </ul>
      </div>
    </div>
    <p><code>ui-kit/</code> reuses the package contract and adds one local allowance: optional <code>stories/</code>.</p>
  </section>

  <section class="policy-wipe" data-policy-wipe data-reveal="100" style="--reveal: 100%;" aria-labelledby="policy-compare-title">
    <header class="policy-wipe-head">
      <div>
        <span>Configuration comparison</span>
        <h4 id="policy-compare-title">Drag to reveal what each config can express.</h4>
      </div>
      <div class="policy-wipe-actions" aria-label="Configuration view">
        <button type="button" data-wipe-value="100" aria-pressed="true">Assura</button>
        <button type="button" data-wipe-value="0" aria-pressed="false">LS-Lint</button>
      </div>
    </header>

    <div class="policy-wipe-control">
      <span>LS-Lint</span>
      <input
        type="range"
        min="0"
        max="100"
        value="100"
        aria-label="Reveal Assura configuration. Zero shows LS-Lint; one hundred shows Assura."
        data-wipe-range
      />
      <span>Assura</span>
    </div>

    <div class="policy-wipe-stage">
      <section class="policy-wipe-layer is-lslint" aria-label="LS-Lint configuration">
        <header><span>LS-Lint</span><strong>Filesystem naming</strong></header>
        <div class="policy-code" role="code" aria-label="LS-Lint YAML example">
          {lsLintLines.map((line) => (
            <div class:list={['policy-code-line', line.tone && `is-${line.tone}`, !line.key && !line.comment && 'is-blank']} style={`--indent: ${line.indent ?? 0}`}>
              {line.comment && !line.key ? <span class="policy-code-comment"># {line.comment}</span> : (
                <><span class="policy-code-key">{line.key}</span>{line.key && <span class="policy-code-colon">:</span>} {line.value && <span class="policy-code-value">{line.value}</span>}{line.comment && <span class="policy-code-comment"> # {line.comment}</span>}</>
              )}
            </div>
          ))}
        </div>
        <div class="policy-layer-summary is-limited">
          <strong>Not expressible here</strong>
          <span>Exact required files</span><span>Line limits</span><span>Reusable semantic rules</span><span>Agent guidance</span>
        </div>
      </section>

      <section class="policy-wipe-layer is-assura" aria-label="Assura configuration">
        <header><span>Assura</span><strong>Reusable project contract</strong></header>
        <div class="policy-code" role="code" aria-label="Assura YAML example">
          {assuraLines.map((line) => (
            <div class:list={['policy-code-line', line.tone && `is-${line.tone}`, !line.key && !line.comment && 'is-blank']} style={`--indent: ${line.indent ?? 0}`}>
              {line.comment && !line.key ? <span class="policy-code-comment"># {line.comment}</span> : (
                <><span class="policy-code-key">{line.key}</span>{line.key && <span class="policy-code-colon">:</span>} {line.value && <span class="policy-code-value">{line.value}</span>}{line.comment && <span class="policy-code-comment"> # {line.comment}</span>}</>
              )}
            </div>
          ))}
        </div>
        <div class="policy-layer-summary is-capable">
          <strong>Added by Assura</strong>
          <span>Built-in baseline</span><span>Required and optional paths</span><span>Scoped line limits</span><span>Local overrides</span>
        </div>
      </section>

      <div class="policy-wipe-divider" aria-hidden="true"><span>↔</span></div>
    </div>
  </section>

</article>

<script>
  const syncWipe = (root: HTMLElement, value: number) => {
    const bounded = Math.max(0, Math.min(100, value));
    root.style.setProperty('--reveal', `${bounded}%`);
    root.dataset.reveal = String(bounded);
    const range = root.querySelector<HTMLInputElement>('[data-wipe-range]');
    if (range) range.value = String(bounded);
    root.querySelectorAll<HTMLButtonElement>('[data-wipe-value]').forEach((button) => {
      button.setAttribute('aria-pressed', String(Number(button.dataset.wipeValue) === bounded));
    });
  };

  document.querySelectorAll<HTMLElement>('[data-policy-wipe]').forEach((root) => {
    root.querySelector<HTMLInputElement>('[data-wipe-range]')?.addEventListener('input', (event) => {
      syncWipe(root, Number((event.currentTarget as HTMLInputElement).value));
    });
    root.querySelectorAll<HTMLButtonElement>('[data-wipe-value]').forEach((button) => {
      button.addEventListener('click', () => syncWipe(root, Number(button.dataset.wipeValue)));
    });
  });
</script>
