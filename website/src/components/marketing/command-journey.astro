---
import {
  checkCommand, onboardingCommand, reviewCommand, releaseScope,
  releaseStatus,
} from '../../data/marketing';

const primaryCommands = [
  {
    label: 'Review',
    phase: 'During agent work',
    role: 'Advisory signal',
    command: reviewCommand,
    body: 'Compare the branch and worktree, rank attention, and show the next useful action without blocking the loop.',
    facts: ['Changed work', 'Hot directories', 'Advisory result'],
    tone: 'review',
  },
  {
    label: 'Check',
    phase: 'Before commit or merge',
    role: 'Policy gate',
    command: checkCommand,
    body: 'Evaluate the configured project contract and return a deterministic pass or fail for hooks and CI.',
    facts: ['Configured rules', 'Exact violations', 'Pass / fail exit'],
    tone: 'check',
  },
];

const supportingCommands = [
  {
    label: 'Set up the baseline',
    command: onboardingCommand,
  },
  {
    label: 'Investigate the current project directory',
    command: 'assura explain .',
  },
];
---

<section
  class="section journey-section"
  aria-labelledby="journey-title"
  data-release-surface="compact-review configured-policy-gate agent-onboarding path-explanation"
>
  <div class="section-head compact">
    <p class="eyebrow">The command model</p>
    <h2 id="journey-title">Review the change. Check the contract.</h2>
    <p>Review keeps agents informed while work is moving. Check makes the final policy decision.</p>
    <p class="command-release-status">
      <strong>{releaseStatus}</strong>
      <span>{releaseScope}</span>
    </p>
  </div>

  <div class="command-model" aria-label="Review and check command roles">
    {primaryCommands.map((item, index) => (
      <article class:list={['command-role', `command-role-${item.tone}`]}>
        <header>
          <div>
            <span class="command-phase">{item.phase}</span>
            <h3>{item.label}</h3>
          </div>
          <span class="command-role-label">{item.role}</span>
        </header>
        <code>{item.command}</code>
        <p>{item.body}</p>
        <ul aria-label={`${item.label} output characteristics`}>
          {item.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        {index === 0 && <span class="command-flow" aria-hidden="true">then</span>}
      </article>
    ))}
  </div>

  <div class="supporting-commands" aria-label="Supporting Assura commands">
    {supportingCommands.map((item) => (
      <div>
        <span>{item.label}</span>
        <code>{item.command}</code>
      </div>
    ))}
  </div>
</section>

<style>
  .journey-section .command-release-status,
  .journey-section .command-role {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .journey-section .command-release-status {
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  .journey-section .supporting-commands > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 0.5rem;
  }

  .journey-section .command-role > code,
  .journey-section .supporting-commands code {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
    font-size: 0.85rem;
    text-align: left;
  }
</style>
