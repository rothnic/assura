---
import performance from '../../data/performance-summary.json';
---

<section
  class="performance-proof"
  aria-label="Performance evidence under review"
  data-release-surface="cold-ls-lint-comparison warm-session-performance"
>
  <div>
    <span>Cold checks</span>
    <strong>Under review</strong>
    <small>No current speed claim.</small>
  </div>
  <div>
    <span>Warm agent loop</span>
    <strong>Under review</strong>
    <small>No current speed claim.</small>
  </div>
  <div class="proof-meta">
    <span>Performance evidence under review</span>
    <span>
      <a href="/insights/benchmark-methodology/" data-analytics-event="performance_methodology_click">How we measured it</a>
      <br />
      <a href="/performance/#measured-comparison">Historical report (recorded version {performance.assura_version})</a>
    </span>
  </div>
</section>

<style>
  @media (min-width: 721px) and (max-width: 980px) {
    .performance-proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .performance-proof > div:nth-child(2) {
      border-right: 0;
    }

    .performance-proof .proof-meta {
      grid-column: 1 / -1;
      border-top: 1px solid var(--border);
    }
  }
</style>
