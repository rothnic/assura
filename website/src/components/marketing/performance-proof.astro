---
import performance from '../../data/performance-summary.json';

const coldRatio = performance.cold.aggregate_speedup_ratio.toFixed(2);
const warmRatio = performance.warm.aggregate_speedup_ratio.toFixed(2);
---

<section class="performance-proof" aria-label="Current Assura performance evidence">
  <div>
    <span>Cold checks</span>
    <strong>{coldRatio}× faster</strong>
    <small>across {performance.cold.measured_fixture_count} LS-Lint comparison projects</small>
  </div>
  <div>
    <span>Warm agent loop</span>
    <strong>{warmRatio}× faster</strong>
    <small>across the same {performance.warm.measured_fixture_count} comparison projects</small>
  </div>
  <div class="proof-meta">
    <span>{performance.cold.measured_fixture_count + performance.warm.measured_fixture_count} measured results</span>
    <a href="/performance/" data-analytics-event="performance_methodology_click">View test results</a>
  </div>
</section>
