---
import performance from '../../data/performance-summary.json';

const coldRatio = performance.cold.aggregate_speedup_ratio.toFixed(2);
const warmRatio = performance.warm.aggregate_speedup_ratio.toFixed(2);
---

<section class="performance-proof" aria-label="Current Assura performance evidence">
  <div>
    <span>Cold checks</span>
    <strong>{performance.cold.assura_faster_count} / {performance.cold.measured_fixture_count}</strong>
    <small>accepted comparisons faster · {coldRatio}× aggregate</small>
  </div>
  <div>
    <span>Warm session</span>
    <strong>{warmRatio}×</strong>
    <small>aggregate · 2× target met in {performance.warm.two_x_pass_count} / {performance.warm.measured_fixture_count}</small>
  </div>
  <div class="proof-meta">
    <span>Assura {performance.assura_version}</span>
    <a href="/reference/performance/">Methodology</a>
  </div>
</section>
