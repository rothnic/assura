---
const comparisons = [
  {
    tool: 'Language linters',
    goodAt: 'Details inside source files for one language or runtime.',
    adds: 'Configured repository structure, required paths and guidance alongside native lint, type checks and tests.',
  },
  {
    tool: 'LS-Lint',
    goodAt: 'Filesystem naming, regex rules and file or directory cardinality.',
    adds: 'Use Assura when content conventions or repair feedback meet an additional need; keep LS-Lint when its policy is sufficient.',
  },
  {
    tool: 'Pre-commit',
    goodAt: 'Installing, selecting and running multi-language hooks.',
    adds: 'Run Assura as another check under the existing runner; retain native commands and hook ownership.',
  },
  {
    tool: 'Dependency tools',
    goodAt: 'Import direction, dependency relationships and unused code analysis.',
    adds: 'Repository path conventions alongside specialist dependency analysis. File presence does not establish code usage or test quality.',
  },
  {
    tool: 'CI',
    goodAt: 'Authoritative post-push validation.',
    adds: 'Local branch and worktree context before the failure leaves the machine.',
  },
  {
    tool: 'Custom scripts',
    goodAt: 'One-off project policy and bespoke checks.',
    adds: 'Shared configuration, one report shape, reusable rules, lifecycle integration, and performance discipline.',
  },
  {
    tool: 'Convention docs',
    goodAt: 'Explaining project intent to people and agents.',
    adds: 'Deterministic findings with the path, rule, and concrete repair context.',
  },
];
---

<div class="comparison-table-wrap">
  <table class="comparison-table">
    <thead>
      <tr>
        <th>Tool</th>
        <th>Good at</th>
        <th>Assura adds</th>
      </tr>
    </thead>
    <tbody>
      {comparisons.map((item) => (
        <tr>
          <th scope="row">{item.tool}</th>
          <td>{item.goodAt}</td>
          <td>{item.adds}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="comparison-accordion">
  {comparisons.map((item, index) => (
    <details open={index === 0}>
      <summary>{item.tool}</summary>
      <dl>
        <div>
          <dt>Good at</dt>
          <dd>{item.goodAt}</dd>
        </div>
        <div>
          <dt>Assura adds</dt>
          <dd>{item.adds}</dd>
        </div>
      </dl>
    </details>
  ))}
</div>
