---
interface TerminalLine {
  text: string;
  tone?: 'prompt' | 'plain' | 'muted' | 'info' | 'warn' | 'pass' | 'fail';
}

interface Props {
  title: string;
  lines: TerminalLine[];
  className?: string;
  variant?: 'review' | 'check' | 'onboarding' | 'neutral';
}

const { title, lines, className = '', variant = 'neutral' } = Astro.props;
---

<div
  class:list={['review-terminal', className]}
  aria-label={title}
  data-terminal-variant={variant}
>
  <div class="terminal-bar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <strong>{title}</strong>
  </div>
  <pre><code>{lines.map((line) => (
    <span class:list={['terminal-line', line.tone ?? 'plain']} data-terminal-line>{line.text}</span>
  ))}</code></pre>
</div>
