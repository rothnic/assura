---
import '../../styles/marketing.css';
import MarketingFooter from './marketing-footer.astro';
import MarketingHeader from './marketing-header.astro';
import SeoHead from './seo-head.astro';

interface NavItem {
  label: string;
  href: string;
  mobile?: boolean;
}

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  imagePath?: string;
  noindex?: boolean;
  navItems: NavItem[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={props.title}
      description={props.description}
      canonicalPath={props.canonicalPath}
      imagePath={props.imagePath}
      noindex={props.noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <MarketingHeader navItems={props.navItems} />
    <slot />
    <MarketingFooter />
    <slot name="scripts" />
  </body>
</html>
