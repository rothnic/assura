---
import currentReport from '../../public/data/performance/current.json';
import nativeReport from '../../public/data/performance/native-current.json';

type ResultRow = {
  fixture_id: string;
  fixture_cohort?: string;
  row_family?: string;
  validation_execution_mode?: string;
  tool_name?: string;
  evidence_role?: string;
  diagnostic?: boolean;
  median_runtime_ms?: number | null;
  p95_runtime_ms?: number | null;
  two_x_target_runtime_ms?: number | null;
  two_x_claim_status?: string | null;
  process_floor_runtime_ms?: number | null;
  rust_cli_floor_runtime_ms?: number | null;
  checked_file_count?: number;
  ignored_file_count?: number;
  directory_count?: number;
  rule_count?: number;
  rule_surface_summary?: string;
  status?: string;
  native_ls_lint_parity?: boolean;
  source_type?: string;
  fixture_source_revision?: string;
  shared_config_id?: string;
  ls_lint_config_path?: string;
  assura_config_path?: string;
  config_generation_method?: string;
  assura_version?: string;
  ls_lint_version?: string;
  ls_lint_execution_mode?: string | null;
  assura_binary_profile?: string | null;
  proves_whole_project_success?: boolean;
  changed_path_count?: number | null;
  latency_threshold_ms?: number | null;
  latency_threshold_met?: boolean | null;
};

type CurrentReport = {
  timestamp?: string;
  commit_sha?: string;
  branch?: string;
  source_worktree_dirty?: boolean;
  command_line?: string;
  assura_version?: string;
  ls_lint_version?: string;
  environment?: {
    os?: string;
    arch?: string;
    cpu_model?: string;
    logical_cpu_count?: number;
    total_memory_bytes?: number | null;
  };
  claim_summary?: {
    fixture_cohort?: string;
    assura_row_family?: string;
    ls_lint_row_family?: string;
    fixture_count?: number;
    measured_fixture_count?: number;
    assura_faster_count?: number;
    two_x_pass_count?: number;
    two_x_fail_count?: number;
    blocked_by_process_floor_count?: number;
    blocked_by_rust_cli_floor_count?: number;
    plain_miss_count?: number;
    aggregate_speedup_ratio?: number | null;
    all_two_x_targets_met?: boolean;
    minimum_completion_iterations?: number;
    measured_iterations?: number;
    sufficient_completion_iterations?: boolean;
    two_x_claim_verdict?: string;
  };
  warm_claim_summary?: {
    fixture_cohort?: string;
    assura_row_family?: string;
    ls_lint_row_family?: string;
    fixture_count?: number;
    measured_fixture_count?: number;
    assura_faster_count?: number;
    two_x_pass_count?: number;
    two_x_fail_count?: number;
    blocked_by_process_floor_count?: number;
    blocked_by_rust_cli_floor_count?: number;
    plain_miss_count?: number;
    aggregate_speedup_ratio?: number | null;
    all_two_x_targets_met?: boolean;
    minimum_completion_iterations?: number;
    measured_iterations?: number;
    sufficient_completion_iterations?: boolean;
    two_x_claim_verdict?: string;
  };
  results?: ResultRow[];
};

type FixtureCopy = {
  label: string;
  projectShape: string;
  focus: string;
};

type Pair = {
  fixtureId: string;
  copy: FixtureCopy;
  assura: ResultRow;
  lslint: ResultRow;
  ratio: number;
  lowerPercent: number;
  winner: string;
};

const report = currentReport as CurrentReport;
const native = nativeReport as CurrentReport;
const rows = (report.results ?? []).filter((row) => row.status === 'pass');
const nativeRows = (native.results ?? []).filter((row) => row.status === 'pass');
const claimSummary = report.claim_summary;
const warmClaimSummary = report.warm_claim_summary;

const generatedFixtureCopy: Record<string, FixtureCopy> = {
  simple_library: {
    label: 'Small library',
    projectShape: 'Rust/package library with docs, tests, and build output.',
    focus: 'Low-end case where startup and config loading are visible.',
  },
  web_app: {
    label: 'Web app',
    projectShape: 'Frontend app with components, tests, CSS modules, assets, and dist output.',
    focus: 'Common app layout with generated output pruning.',
  },
  monorepo_packages: {
    label: 'Package monorepo',
    projectShape: 'Two packages with package-local source, tests, docs, and dist output.',
    focus: 'Nested package scopes without becoming a synthetic stress test.',
  },
  monorepo_policy: {
    label: 'Monorepo policy',
    projectShape: 'Strict TypeScript/Next-style workspace with app, package, docs, scripts, infra, and CI scopes.',
    focus: 'Policy-shaped rules: root whitelisting, config exceptions, source bans, and generated-output pruning.',
  },
  rule_heavy_repo: {
    label: 'Rule-heavy repo',
    projectShape: 'Repo-shaped tree with many extension-specific file rules.',
    focus: 'Broad LS-Lint-compatible naming surface.',
  },
  ignored_generated_heavy_repo: {
    label: 'Generated-heavy repo',
    projectShape: 'Project with large generated and coverage folders inside the tree.',
    focus: 'Ignored-path pruning before validation work is spent.',
  },
};

const realRepoFixtureCopy: Record<string, FixtureCopy> = {
  pinned_nextjs: {
    label: 'Next.js monorepo',
    projectShape: 'Large frontend framework monorepo with packages, examples, tests, and generated output.',
    focus: 'Framework-scale tree, route naming conventions, package scopes, and generated-output pruning.',
  },
  pinned_mdbook: {
    label: 'mdBook docs project',
    projectShape: 'Rust documentation tool with source, book content, docs, and target output.',
    focus: 'Docs-heavy Rust project with source, Markdown, TOML, and target pruning.',
  },
  pinned_vite: {
    label: 'Vite tooling monorepo',
    projectShape: 'Frontend tooling monorepo with packages, playgrounds, docs, and build output.',
    focus: 'Package and playground scopes with docs/build-output pruning.',
  },
  pinned_tailwindcss: {
    label: 'Tailwind CSS package',
    projectShape: 'CSS tooling package with source, tests, fixtures, and generated output.',
    focus: 'Source/test naming policy with generated-output pruning.',
  },
  pinned_prettier: {
    label: 'Prettier formatter repo',
    projectShape: 'JavaScript formatter repository with source, tests, website, and fixtures.',
    focus: 'Source, tests, website, and fixture/generated-output policy.',
  },
  pinned_pnpm: {
    label: 'pnpm monorepo',
    projectShape: 'Package-manager monorepo with package scopes, fixtures, typings, and build output.',
    focus: 'Package-scope rules, typings, dotfile allowances, and generated-output pruning.',
  },
  pinned_rustlings: {
    label: 'Rustlings exercises',
    projectShape: 'Rust education repository with exercises, solutions, docs, and target output.',
    focus: 'Exercise and solution structure with target pruning.',
  },
  pinned_clap: {
    label: 'clap Rust workspace',
    projectShape: 'Rust CLI workspace with crates, examples, tests, and target output.',
    focus: 'Crate and example scopes for a Rust workspace.',
  },
  pinned_ripgrep: {
    label: 'ripgrep CLI repo',
    projectShape: 'Rust CLI repository with crates, tests, docs, scripts, and target output.',
    focus: 'CLI project structure with crate scopes and target pruning.',
  },
  pinned_tokio: {
    label: 'Tokio async workspace',
    projectShape: 'Rust async workspace with crate scopes, examples, benches, and target output.',
    focus: 'Multi-crate Rust workspace policy with examples and benchmarks.',
  },
};

const isRealRepoHeadline =
  claimSummary?.fixture_cohort === 'real-repo-headline' ||
  rows.some((row) => row.fixture_cohort === 'real-repo-headline');
const headlineFixtureCopy = isRealRepoHeadline ? realRepoFixtureCopy : generatedFixtureCopy;
const headlineFixtureIds = Object.keys(headlineFixtureCopy);

function rowFamily(row: ResultRow): string {
  return row.row_family ?? row.tool_name ?? '';
}

function buildPair(fixtureId: string): Pair | null {
  const copy = headlineFixtureCopy[fixtureId];
  const assura = rows.find(
    (row) => row.fixture_id === fixtureId && rowFamily(row) === 'assura-cli',
  ) ?? rows.find((row) => row.fixture_id === fixtureId && rowFamily(row) === 'assura-check-cli');
  const lslint = rows.find(
    (row) => row.fixture_id === fixtureId && rowFamily(row) === 'ls-lint-cli',
  );
  if (!assura?.median_runtime_ms || !lslint?.median_runtime_ms) {
    return null;
  }

  return {
    fixtureId,
    copy,
    assura,
    lslint,
    ...compareRuntimes(assura.median_runtime_ms, lslint.median_runtime_ms),
  };
}

const headlinePairs = headlineFixtureIds.map(buildPair).filter((pair): pair is Pair => Boolean(pair));
const datasetRevisions = Array.from(
  new Set(
    headlinePairs
      .map((pair) => pair.assura.fixture_source_revision)
      .filter((revision): revision is string => Boolean(revision)),
  ),
);
const datasetLabel = isRealRepoHeadline
  ? `${claimSummary?.fixture_count ?? headlinePairs.length} pinned real repositories`
  : datasetRevisions.length > 0 ? datasetRevisions.join(' + ') : 'generated fixtures';

const syntheticRows = rows.filter(
  (row) => row.row_family === 'assura-cli' && row.fixture_cohort === 'synthetic-stress',
);
const nativeFixtureIds = Array.from(new Set(nativeRows.map((row) => row.fixture_id)));
const nativeFixtureSummaries = nativeFixtureIds.map((fixtureId) => {
  const fixtureRows = nativeRows.filter((row) => row.fixture_id === fixtureId);
  const slowest = fixtureRows.reduce<ResultRow | null>(
    (current, row) => (
      !current || (row.median_runtime_ms ?? 0) > (current.median_runtime_ms ?? 0)
        ? row
        : current
    ),
    null,
  );
  const checkRow = fixtureRows.find((row) => row.row_family === 'native:content-check-cli');
  return { fixtureId, fixtureRows, slowest, checkRow };
});
const firstAssuraRow =
  rows.find((row) => row.row_family === 'assura-cli') ??
  rows.find((row) => row.row_family === 'assura-check-cli');
const firstLsLintRow = rows.find((row) => row.row_family === 'ls-lint-cli');
const releaseProfile = firstAssuraRow?.assura_binary_profile ?? 'unknown profile';
const platformLabel = [report.environment?.os, report.environment?.arch].filter(Boolean).join(' / ') || 'unknown platform';
const hardwareLabel = [
  report.environment?.cpu_model,
  report.environment?.logical_cpu_count ? `${report.environment.logical_cpu_count} logical CPUs` : null,
].filter(Boolean).join('; ') || 'unknown hardware';
const commandLine = report.command_line ?? 'not recorded';
const sourceState = report.source_commit_sha
  ? report.source_worktree_dirty
    ? 'source lane dirty when materialized'
    : 'source lane clean when materialized'
  : report.source_worktree_dirty
    ? 'measured worktree dirty'
    : 'measured worktree clean';
const nativeCommandLine = native.command_line ?? 'not recorded';
const nativeSourceState = native.source_commit_sha
  ? native.source_worktree_dirty
    ? 'source lane dirty when materialized'
    : 'source lane clean when materialized'
  : native.source_worktree_dirty
    ? 'measured worktree dirty'
    : 'measured worktree clean';

const totalAssura = headlinePairs.reduce(
  (total, pair) => total + (pair.assura.median_runtime_ms ?? 0),
  0,
);
const totalLsLint = headlinePairs.reduce(
  (total, pair) => total + (pair.lslint.median_runtime_ms ?? 0),
  0,
);
const totalComparison = compareRuntimes(totalAssura, totalLsLint);
const closestPair = headlinePairs.reduce<Pair | null>(
  (closest, pair) => (!closest || pair.ratio < closest.ratio ? pair : closest),
  null,
);

function compareRuntimes(assuraMs: number, lsLintMs: number): Pick<Pair, 'ratio' | 'lowerPercent' | 'winner'> {
  if (assuraMs === lsLintMs) {
    return { ratio: 1, lowerPercent: 0, winner: 'Tie' };
  }
  const assuraWins = assuraMs < lsLintMs;
  const faster = assuraWins ? assuraMs : lsLintMs;
  const slower = assuraWins ? lsLintMs : assuraMs;
  return {
    ratio: slower / faster,
    lowerPercent: (1 - faster / slower) * 100,
    winner: assuraWins ? 'Assura' : 'Native LS-Lint',
  };
}

function formatMs(value?: number | null): string {
  return typeof value === 'number' ? `${value.toFixed(value >= 10 ? 1 : 2)} ms` : 'n/a';
}

function formatPercent(value: number): string {
  return `${value.toFixed(1)}%`;
}

function formatSpeedup(value: number): string {
  return `${value.toFixed(value >= 10 ? 1 : 2)}x`;
}

function formatTwoXStatus(row: ResultRow): string | null {
  switch (row.two_x_claim_status) {
    case 'meets-target':
      return `2x target met (${formatMs(row.two_x_target_runtime_ms)})`;
    case 'blocked-by-process-floor':
      return `2x target blocked by process floor (${formatMs(row.process_floor_runtime_ms)})`;
    case 'blocked-by-rust-cli-floor':
      return `2x target blocked by Rust CLI floor (${formatMs(row.rust_cli_floor_runtime_ms)})`;
    case 'misses-target':
      return `2x target missed (${formatMs(row.two_x_target_runtime_ms)})`;
    default:
      return null;
  }
}

function formatVerdict(value?: string): string {
  switch (value) {
    case 'complete':
      return 'Complete';
    case 'not-complete-low-sample':
      return 'Not complete (low sample)';
    default:
      return 'Not complete';
  }
}

function formatCount(numerator?: number, denominator?: number): string {
  return `${numerator ?? 0} / ${denominator ?? 0}`;
}

function shortSha(value?: string): string {
  return value ? value.slice(0, 7) : 'unknown';
}

function formatTimestamp(value?: string): string {
  if (!value) return 'unknown';
  return value.replace('T', ' ').replace('Z', ' UTC');
}

function lslintVersion(value?: string): string {
  return value?.split('\n')[0] ?? 'unknown';
}

function scale(row: ResultRow): string {
  return `${row.checked_file_count ?? 0} checked, ${row.ignored_file_count ?? 0} ignored, ${row.directory_count ?? 0} dirs`;
}

function ruleCount(row: ResultRow): string {
  return `${row.rule_count ?? 0} LS-Lint rules`;
}

function testCaseHref(fixtureId: string): string {
  return `/reference/performance-test-cases/#${fixtureId.replaceAll('_', '-')}`;
}
---

<section class="perf-evidence" aria-labelledby="performance-summary">
  <div class="perf-summary">
    <p class="perf-kicker">Current comparison</p>
    <h2 id="performance-summary">Assura CLI vs native LS-Lint CLI</h2>
    <p class="perf-summary-line">
      {isRealRepoHeadline
        ? 'Pinned real repositories at immutable revisions. Native LS-Lint-compatible policies. Case definitions live on the test-case page.'
        : 'Generated stable trees. Equivalent rules. Case definitions live on the test-case page.'}
    </p>

    <div class="perf-summary-grid">
      <dl class="perf-facts" aria-label="Performance summary facts">
        <div>
          <dt>Faster tool</dt>
          <dd>{totalComparison.winner}</dd>
        </div>
        <div>
          <dt>Runtime ratio</dt>
          <dd>{formatSpeedup(claimSummary?.aggregate_speedup_ratio ?? totalComparison.ratio)}</dd>
        </div>
        <div>
          <dt>2x gate</dt>
          <dd>{formatVerdict(claimSummary?.two_x_claim_verdict)}</dd>
        </div>
        <div>
          <dt>2x cases</dt>
          <dd>{formatCount(claimSummary?.two_x_pass_count, claimSummary?.measured_fixture_count)}</dd>
        </div>
        <div>
          <dt>Assura faster</dt>
          <dd>{formatCount(claimSummary?.assura_faster_count ?? headlinePairs.length, claimSummary?.measured_fixture_count ?? headlinePairs.length)}</dd>
        </div>
      </dl>

      <dl class="perf-run-context" aria-label="Report context">
        <div>
          <dt>Dataset</dt>
          <dd><a href="/reference/performance-test-cases/">{datasetLabel}</a></dd>
        </div>
        <div>
          <dt>Build profile</dt>
          <dd>{releaseProfile}; {platformLabel}</dd>
        </div>
        <div>
          <dt>Hardware</dt>
          <dd>{hardwareLabel}</dd>
        </div>
        <div>
          <dt>Closest case</dt>
          <dd>{closestPair ? `${formatSpeedup(closestPair.ratio)} on ${closestPair.copy.label}` : 'n/a'}</dd>
        </div>
        <div>
          <dt>Floor-limited misses</dt>
          <dd>{formatCount((claimSummary?.blocked_by_process_floor_count ?? 0) + (claimSummary?.blocked_by_rust_cli_floor_count ?? 0), claimSummary?.two_x_fail_count)}</dd>
        </div>
        <div>
          <dt>Warm 2x gate</dt>
          <dd>{formatVerdict(warmClaimSummary?.two_x_claim_verdict)}; {formatCount(warmClaimSummary?.two_x_pass_count, warmClaimSummary?.measured_fixture_count)} cases</dd>
        </div>
        <div>
          <dt>Evidence source</dt>
          <dd>Commit <code>{shortSha(report.commit_sha)}</code>; {sourceState}</dd>
        </div>
        <div>
          <dt>Command</dt>
          <dd><code>{commandLine}</code></dd>
        </div>
        <div>
          <dt>Captured</dt>
          <dd>{formatTimestamp(report.timestamp)}</dd>
        </div>
        <div>
          <dt>Versions</dt>
          <dd>Assura {firstAssuraRow?.assura_version ?? report.assura_version ?? 'unknown'}; {lslintVersion(firstLsLintRow?.ls_lint_version ?? report.ls_lint_version)} native binary</dd>
        </div>
      </dl>
    </div>
  </div>

  <h2 id="test-case-results">Headline Case Results</h2>
  <p class="perf-section-intro">
    One row per measured headline case. Open a case to inspect the repository
    shape and the policy surface behind the comparison.
  </p>

  <div class="perf-table-wrap" aria-label="Assura and LS-Lint comparison by test case">
    <table class="perf-table">
      <thead>
        <tr>
          <th>Test case</th>
          <th>Project shape</th>
          <th>Runtime</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody>
        {headlinePairs.map((pair) => (
          <tr>
            <td data-label="Test case">
              <strong><a href={testCaseHref(pair.fixtureId)}>{pair.copy.label}</a></strong>
              <span class="perf-cell-note"><code>{pair.fixtureId}</code></span>
            </td>
            <td data-label="Project shape">
              {pair.copy.projectShape}
              <span class="perf-cell-note">{scale(pair.assura)}; {ruleCount(pair.assura)}</span>
              <span class="perf-cell-note">{pair.copy.focus}</span>
            </td>
            <td data-label="Runtime">
              <strong>Assura CLI:</strong> {formatMs(pair.assura.median_runtime_ms)}
              <span class="perf-cell-note">Native LS-Lint: {formatMs(pair.lslint.median_runtime_ms)}</span>
            </td>
            <td data-label="Result">
              <strong>{pair.winner}: {formatSpeedup(pair.ratio)}</strong>
              <span class="perf-cell-note">{formatPercent(pair.lowerPercent)} lower runtime</span>
              {formatTwoXStatus(pair.assura) && (
                <span class="perf-cell-note">{formatTwoXStatus(pair.assura)}</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="perf-note">
    {isRealRepoHeadline ? (
      <>
        <strong>Scope:</strong> this headline uses pinned real repositories.
        Generated and adversarial fixtures remain in the report as supporting
        regression coverage, not as the public aggregate proof.
      </>
    ) : (
      <>
        <strong>What this does not prove yet:</strong> this checked report uses
        generated fixtures. Run the external-fixture command on the test-case
        page to produce the real-repo headline evidence.
      </>
    )}
  </div>

  <h2 id="diagnostic-coverage">Diagnostic Coverage</h2>
  <p>
    The report also keeps synthetic stress cases for regression detection. They
    are intentionally excluded from the headline comparison.
  </p>

  <div class="perf-diagnostic-list" aria-label="Synthetic stress fixtures">
    {syntheticRows.map((row) => (
      <div>
        <strong><code>{row.fixture_id}</code></strong>
        <span>{scale(row)}</span>
        <span>{row.rule_count} rules; {row.rule_surface_summary}</span>
      </div>
    ))}
  </div>

  <h2 id="native-performance">Assura-Native Performance</h2>
  <p class="perf-section-intro">
    Native rows measure Assura-only capabilities that LS-Lint does not provide:
    content collections, graph queries, references, context packs, Markdown
    safe-fix dry runs, agent-query paths, session-style requests, and daemon
    status. These rows are diagnostic product evidence, not substitutes for
    the LS-Lint-equivalent cold CLI gate above.
  </p>

  <dl class="perf-run-context" aria-label="Native performance report context">
    <div>
      <dt>Native report</dt>
      <dd><a href="/data/performance/native-current.json">native-current.json</a></dd>
    </div>
    <div>
      <dt>History</dt>
      <dd><a href="/data/performance/native-history.jsonl">native-history.jsonl</a></dd>
    </div>
    <div>
      <dt>Rows</dt>
      <dd>{nativeRows.length} passing rows across {nativeFixtureSummaries.length} fixtures</dd>
    </div>
    <div>
      <dt>Evidence source</dt>
      <dd>Commit <code>{shortSha(native.commit_sha)}</code>; {nativeSourceState}</dd>
    </div>
    <div>
      <dt>Captured</dt>
      <dd>{formatTimestamp(native.timestamp)}</dd>
    </div>
    <div>
      <dt>Command</dt>
      <dd><code>{nativeCommandLine}</code></dd>
    </div>
  </dl>

  <div class="perf-table-wrap" aria-label="Assura-native performance by fixture">
    <table class="perf-table">
      <thead>
        <tr>
          <th>Native fixture</th>
          <th>Scale</th>
          <th>Rows</th>
          <th>Slowest measured row</th>
        </tr>
      </thead>
      <tbody>
        {nativeFixtureSummaries.map(({ fixtureId, fixtureRows, slowest, checkRow }) => (
          <tr>
            <td data-label="Native fixture">
              <strong><a href={testCaseHref(fixtureId)}>{fixtureId.replaceAll('_', ' ')}</a></strong>
              <span class="perf-cell-note"><code>{fixtureId}</code></span>
            </td>
            <td data-label="Scale">
              {checkRow ? scale(checkRow) : 'n/a'}
              {checkRow?.rule_surface_summary && (
                <span class="perf-cell-note">{checkRow.rule_surface_summary}</span>
              )}
            </td>
            <td data-label="Rows">
              {fixtureRows.length} native diagnostic rows
              <span class="perf-cell-note">Gate: <code>cargo xtask native-performance-no-regression</code></span>
            </td>
            <td data-label="Slowest measured row">
              {slowest ? (
                <>
                  <strong>{formatMs(slowest.median_runtime_ms)}</strong>
                  <span class="perf-cell-note"><code>{slowest.row_family}</code></span>
                </>
              ) : 'n/a'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
