---
import heroImage from '../assets/assura-landing-hero.webp';

const pageTitle = 'Assura | Executable repository structure';
const pageDescription =
  'Assura turns repository shape, documentation contracts, and agent handoffs into local checks that run before drift reaches review.';

const productPillars = [
  {
    eyebrow: 'Structure',
    title: 'Make the repo shape explicit',
    body: 'Declare allowed paths, required files, naming rules, and generated-output exclusions in `.assura/config.yml`.',
  },
  {
    eyebrow: 'Feedback',
    title: 'Return repairable findings',
    body: 'Use text, JSON, YAML, advice, status, or agent output without adding a hosted service to the workflow.',
  },
  {
    eyebrow: 'Handoff',
    title: 'Give agents a checked baseline',
    body: 'Onboard agents with local evidence, lifecycle profiles, and next actions before specialization starts.',
  },
];

const workflowSteps = [
  'Install the CLI from a release archive.',
  'Initialize or migrate structure policy.',
  'Run checks locally, in hooks, or in CI.',
  'Feed bounded results back to humans and agents.',
];

const proofPoints = [
  'Rust CLI with local-only validation paths',
  'LS-Lint migration for existing naming policy',
  'Machine-readable reports for CI and agent hooks',
  'Checked performance evidence published in docs',
];

const heroBadges = ['Local CLI', 'CI-ready reports', 'Agent handoffs'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://assura.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://assura.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="theme-color" content="#08111f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f8f7" media="(prefers-color-scheme: light)" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" aria-label="Primary">
      <a class="brand" href="/" aria-label="Assura home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Assura</span>
      </a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="/guides/quickstart/">Docs</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="/reference/performance/">Performance</a>
        <a href="https://github.com/rothnic/assura">GitHub</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">Structure-first validation for local developer workflows</p>
          <h1 id="hero-title">Your repo structure, checked before review.</h1>
          <p class="hero-copy">
            Assura turns folder shape, docs contracts, and agent handoffs into local checks
            that run before drift becomes review debt.
          </p>
          <ul class="hero-badges" aria-label="Assura product strengths">
            {heroBadges.map((badge) => <li>{badge}</li>)}
          </ul>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="/guides/quickstart/">Start checking</a>
            <a class="button button-secondary" href="https://github.com/rothnic/assura">
              View GitHub
            </a>
          </div>
          <pre class="install-line" aria-label="Install command"><code>curl -fsSL https://raw.githubusercontent.com/rothnic/assura/master/website/public/install.sh | sh</code></pre>
        </div>
      </section>

      <section class="intro-band" aria-labelledby="intro-title">
        <div class="section-copy">
          <p class="eyebrow">What Assura does</p>
          <h2 id="intro-title">It makes project conventions testable.</h2>
          <p>
            Most repository standards live in memory, docs, or review comments. Assura keeps
            the contract in the repo and gives both people and coding agents the same local
            source of truth.
          </p>
        </div>
        <div class="signal-list" aria-label="Assura capabilities">
          {
            productPillars.map((pillar) => (
              <article class="signal-card">
                <span>{pillar.eyebrow}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="workflow-band" aria-labelledby="workflow-title">
        <div class="workflow-copy">
          <p class="eyebrow">Operational shape</p>
          <h2 id="workflow-title">A checkable path from first run to CI.</h2>
          <p>
            Start with broad structure validation, then tighten the contract as the project
            learns what should be stable.
          </p>
        </div>
        <ol class="workflow-steps">
          {
            workflowSteps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{step}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="proof-band" aria-labelledby="proof-title">
        <div class="section-copy">
          <p class="eyebrow">Proof surfaces</p>
          <h2 id="proof-title">Built for evidence-heavy teams.</h2>
          <p>
            Assura keeps validation ordinary: local files, local commands, report formats,
            and docs that point back to checked artifacts.
          </p>
        </div>
        <div class="proof-grid">
          {
            proofPoints.map((point) => (
              <div class="proof-item">
                <span aria-hidden="true"></span>
                <p>{point}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="final-band" aria-labelledby="final-title">
        <div>
          <p class="eyebrow">Start small</p>
          <h2 id="final-title">Install, initialize, and make drift visible.</h2>
        </div>
        <div class="final-actions">
          <a class="button button-primary" href="/guides/installation/">Install Assura</a>
          <a class="button button-secondary" href="/guides/agent-ready-onboarding/">
            Agent onboarding
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    color-scheme: light;
    --landing-bg: #f7f9f8;
    --landing-surface: #ffffff;
    --landing-surface-muted: #eef3f1;
    --landing-text: #102022;
    --landing-muted: #526568;
    --landing-soft: #6d7e82;
    --landing-border: rgba(16, 32, 34, 0.14);
    --landing-primary: #066b75;
    --landing-primary-strong: #075c66;
    --landing-accent: #087a54;
    --landing-accent-hover: #066b75;
    --landing-accent-contrast: #ffffff;
    --landing-amber: #b87706;
    --landing-shadow: rgba(11, 25, 30, 0.18);
    --landing-hero-text: #f3fbfa;
    --landing-hero-muted: rgba(243, 251, 250, 0.78);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      color-scheme: dark;
      --landing-bg: #08111f;
      --landing-surface: #0d1a26;
      --landing-surface-muted: #132434;
      --landing-text: #edf7f5;
      --landing-muted: #a9bbbf;
      --landing-soft: #7c9197;
      --landing-border: rgba(141, 244, 227, 0.18);
      --landing-primary: #66e6f4;
      --landing-primary-strong: #9bf4fd;
      --landing-accent: #83f3aa;
      --landing-accent-hover: #9bf4bd;
      --landing-accent-contrast: #061511;
      --landing-amber: #ffd166;
      --landing-shadow: rgba(0, 0, 0, 0.42);
      --landing-hero-text: #f8fffd;
      --landing-hero-muted: rgba(248, 255, 253, 0.76);
    }
  }

  :global(html) {
    min-width: 320px;
    background: var(--landing-bg);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background:
      linear-gradient(180deg, transparent 0, var(--landing-bg) 44rem),
      var(--landing-bg);
    color: var(--landing-text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  :global(a) {
    color: inherit;
  }

  .skip-link {
    position: fixed;
    z-index: 30;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    border: 1px solid rgba(238, 255, 252, 0.28);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: #061511;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: fixed;
    z-index: 10;
    top: 0;
    left: 50%;
    display: flex;
    width: min(100% - 2rem, 1160px);
    min-height: 4.25rem;
    transform: translateX(-50%);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--landing-hero-text);
  }

  .brand,
  .nav-links {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    gap: 0.65rem;
    min-width: 0;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 800;
  }

  .brand-mark {
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid rgba(139, 249, 230, 0.58);
    border-radius: 0.45rem;
    background:
      linear-gradient(135deg, rgba(102, 230, 244, 0.24), transparent 62%),
      rgba(8, 17, 31, 0.72);
    box-shadow: inset 0 0 0 0.35rem rgba(131, 243, 170, 0.08);
  }

  .nav-links {
    gap: 0.4rem;
    padding: 0.32rem;
    border: 1px solid rgba(231, 255, 251, 0.16);
    border-radius: 0.5rem;
    background: rgba(5, 12, 22, 0.62);
    backdrop-filter: blur(18px);
  }

  .nav-links a {
    padding: 0.48rem 0.72rem;
    border-radius: 0.38rem;
    color: rgba(248, 255, 253, 0.82);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links a:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(700px, 78svh);
    align-items: center;
    overflow: hidden;
    padding: clamp(5.3rem, 8vw, 6.8rem) clamp(1rem, 4vw, 3rem) clamp(2rem, 5vw, 3.2rem);
    color: var(--landing-hero-text);
  }

  .hero-image {
    position: absolute;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-scrim {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(4, 10, 18, 0.86) 0%, rgba(4, 10, 18, 0.64) 46%, rgba(4, 10, 18, 0.3) 100%),
      rgba(4, 10, 18, 0.14);
  }

  .hero-content {
    width: min(100%, 1160px);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--landing-accent);
    font-size: 0.77rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 6.4vw, 5.35rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .hero-copy {
    max-width: 43rem;
    margin: 1.05rem 0 0;
    color: var(--landing-hero-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.34rem);
    line-height: 1.48;
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-actions {
    margin-top: 1.45rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-badges li {
    border: 1px solid rgba(238, 255, 252, 0.2);
    border-radius: 0.5rem;
    padding: 0.43rem 0.58rem;
    background: rgba(8, 17, 31, 0.5);
    color: rgba(248, 255, 253, 0.82);
    font-size: 0.78rem;
    font-weight: 750;
    line-height: 1;
    backdrop-filter: blur(12px);
  }

  .button {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.85rem 1.05rem;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 820;
    line-height: 1;
    white-space: nowrap;
  }

  .button-primary {
    background: var(--landing-accent);
    color: var(--landing-accent-contrast);
    box-shadow: 0 0.7rem 1.7rem rgba(42, 236, 164, 0.24);
  }

  .button-primary:hover {
    background: var(--landing-accent-hover);
  }

  .button-secondary {
    border-color: rgba(238, 255, 252, 0.24);
    background: rgba(8, 17, 31, 0.58);
    color: var(--landing-hero-text);
    backdrop-filter: blur(14px);
  }

  .button-secondary:hover {
    border-color: rgba(238, 255, 252, 0.42);
  }

  .install-line {
    width: min(100%, 48rem);
    margin: 1rem 0 0;
    overflow: hidden;
    border: 1px solid rgba(232, 255, 252, 0.2);
    border-radius: 0.5rem;
    background: rgba(4, 10, 18, 0.68);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.22);
  }

  .install-line code {
    display: block;
    padding: 0.8rem 0.95rem;
    color: rgba(238, 255, 252, 0.9);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .intro-band,
  .workflow-band,
  .proof-band,
  .final-band {
    width: min(100% - 2rem, 1160px);
    margin: 0 auto;
    padding: clamp(3.2rem, 7vw, 5.8rem) 0;
  }

  .intro-band,
  .proof-band {
    display: grid;
    grid-template-columns: minmax(0, 0.74fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .section-copy h2,
  .workflow-copy h2,
  .final-band h2 {
    margin: 0;
    color: var(--landing-text);
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .section-copy p,
  .workflow-copy p {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--landing-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .signal-list,
  .proof-grid {
    display: grid;
    gap: 0.8rem;
  }

  .signal-card {
    padding: 1.15rem;
    border: 1px solid var(--landing-border);
    border-radius: 0.5rem;
    background: var(--landing-surface);
    box-shadow: 0 1px 2px rgba(6, 21, 26, 0.04);
  }

  .signal-card span {
    color: var(--landing-primary);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .signal-card h3 {
    margin: 0.45rem 0 0;
    color: var(--landing-text);
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .signal-card p {
    margin: 0.55rem 0 0;
    color: var(--landing-muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .workflow-band {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--landing-border);
    border-bottom: 1px solid var(--landing-border);
  }

  .workflow-steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: steps;
  }

  .workflow-steps li {
    display: grid;
    grid-template-columns: 4.3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    min-height: 5rem;
    border-bottom: 1px solid var(--landing-border);
  }

  .workflow-steps li:last-child {
    border-bottom: 0;
  }

  .workflow-steps span {
    color: var(--landing-primary);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.88rem;
    font-weight: 800;
  }

  .workflow-steps p {
    margin: 0;
    color: var(--landing-text);
    font-size: clamp(1.05rem, 2vw, 1.45rem);
    line-height: 1.32;
  }

  .proof-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .proof-item {
    min-height: 8rem;
    padding: 1rem;
    border: 1px solid var(--landing-border);
    border-radius: 0.5rem;
    background: var(--landing-surface-muted);
  }

  .proof-item span {
    display: block;
    width: 0.72rem;
    height: 0.72rem;
    margin-bottom: 1.35rem;
    border-radius: 50%;
    background: var(--landing-accent);
    box-shadow: 0 0 0 0.4rem rgba(15, 159, 110, 0.13);
  }

  .proof-item p {
    margin: 0;
    color: var(--landing-text);
    font-size: 1rem;
    line-height: 1.45;
  }

  .final-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid var(--landing-border);
    border-radius: 0.5rem;
    padding: clamp(1.3rem, 4vw, 2rem);
    background: var(--landing-surface);
    box-shadow: 0 1px 2px rgba(6, 21, 26, 0.06);
  }

  .final-band .eyebrow {
    margin-bottom: 0.55rem;
  }

  .final-band h2 {
    max-width: 15ch;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
  }

  .final-actions .button-secondary {
    border-color: var(--landing-border);
    background: transparent;
    color: var(--landing-text);
    backdrop-filter: none;
  }

  @media (max-width: 820px) {
    .site-header {
      position: absolute;
      align-items: flex-start;
      padding-top: 1rem;
    }

    .nav-links {
      max-width: min(68vw, 28rem);
      justify-content: flex-end;
      flex-wrap: wrap;
      border-radius: 0.5rem;
    }

    .nav-links a {
      padding: 0.44rem 0.58rem;
      font-size: 0.76rem;
    }

    .hero {
      min-height: min(680px, 78svh);
      padding-top: 7rem;
    }

    h1 {
      max-width: 12ch;
      font-size: clamp(2.55rem, 13vw, 4.2rem);
    }

    .hero-copy {
      max-width: 33rem;
    }

    .intro-band,
    .workflow-band,
    .proof-band {
      grid-template-columns: 1fr;
    }

    .proof-grid {
      grid-template-columns: 1fr 1fr;
    }

    .final-band {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      width: min(100% - 1rem, 1160px);
      min-height: 3.5rem;
      gap: 0.5rem;
    }

    .brand {
      font-size: 0.92rem;
    }

    .brand-mark {
      width: 1.35rem;
      height: 1.35rem;
      border-radius: 0.38rem;
    }

    .nav-links {
      gap: 0.15rem;
      max-width: 62vw;
      padding: 0.25rem;
    }

    .nav-links a {
      padding: 0.35rem 0.42rem;
      font-size: 0.69rem;
    }

    .nav-links a:nth-child(3) {
      display: none;
    }

    .hero {
      min-height: min(660px, 80svh);
      padding-right: 0.85rem;
      padding-left: 0.85rem;
    }

    .hero-scrim {
      background: rgba(4, 10, 18, 0.68);
    }

    .eyebrow {
      font-size: 0.7rem;
    }

    .hero-copy {
      font-size: 1rem;
      line-height: 1.55;
    }

    .button {
      width: 100%;
      white-space: normal;
    }

    .install-line {
      display: none;
    }

    .intro-band,
    .workflow-band,
    .proof-band,
    .final-band {
      width: min(100% - 1.3rem, 1160px);
    }

    .section-copy h2,
    .workflow-copy h2 {
      font-size: clamp(1.95rem, 12vw, 3rem);
    }

    .workflow-steps li {
      grid-template-columns: 3.15rem minmax(0, 1fr);
      min-height: 4.55rem;
    }

    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
