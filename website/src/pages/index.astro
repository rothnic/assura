---
import heroImage from '../assets/assura-landing-hero.webp';

const pageTitle = 'Assura | Repository structure as a contract';
const pageDescription =
  'Assura is a fast local CLI that turns repository structure, naming, docs conventions, and agent handoffs into checkable contracts.';

const installCommand =
  'curl -fsSL https://raw.githubusercontent.com/rothnic/assura/master/website/public/install.sh | sh';

const navItems = [
  { label: 'Docs', href: '/guides/quickstart/' },
  { label: 'Compare', href: '#compare' },
  { label: 'Roadmap', href: '/roadmap/' },
  { label: 'Performance', href: '/reference/performance/' },
  { label: 'GitHub', href: 'https://github.com/rothnic/assura' },
];

const heroFacts = [
  'Single Rust binary',
  'Deterministic local checks',
  'Agent-readable output',
];

const terminalLines = [
  { text: '$ assura review', tone: 'prompt' },
  { text: 'Assura review  needs-review', tone: 'plain' },
  { text: 'Check: pass  files=1562 dirs=353 violations=0', tone: 'plain' },
  { text: 'Branch: files=8 lines=+412/-96 commits=3', tone: 'info' },
  { text: 'Worktree: modified=2 untracked=1 lines=+74/-18', tone: 'info' },
  { text: 'Hot dirs: src/cli, website/src', tone: 'muted' },
  { text: '', tone: 'plain' },
  { text: 'Next: inspect shape before policy changes', tone: 'pass' },
];

const problemPoints = [
  {
    label: 'Structure drift',
    body: 'Stray files, misnamed modules, and phantom directories accumulate one pull request at a time.',
  },
  {
    label: 'Agent speed',
    body: 'Coding agents can create more files in one pass than a reviewer can police by hand.',
  },
  {
    label: 'Docs are not gates',
    body: 'CONTRIBUTING.md explains the convention. Assura makes the same convention executable.',
  },
];

const contractLayers = [
  {
    label: 'Repo contract',
    title: 'Top-level shape',
    body: 'Allowed directories, required docs, generated-output boundaries.',
    signal: 'language agnostic',
  },
  {
    label: 'Review signal',
    title: 'Branch and worktree heat',
    body: 'Changed files, line churn, untracked paths, hot directories.',
    signal: 'fast local feedback',
  },
  {
    label: 'Agent loop',
    title: 'Repairable findings',
    body: 'Bounded context that tells coding agents what changed and how to fix it.',
    signal: 'machine actionable',
  },
  {
    label: 'Extension hooks',
    title: 'Project-specific depth',
    body: 'Attach language, content, release, or policy checks after shape is stable.',
    signal: 'layered validation',
  },
];

const reviewSignals = [
  {
    label: 'Branch',
    value: '8 files',
    detail: '+412 / -96 lines',
  },
  {
    label: 'Worktree',
    value: '2 modified',
    detail: '1 untracked',
  },
  {
    label: 'Hot path',
    value: 'src/cli',
    detail: 'policy + churn',
  },
];

const capabilities = [
  {
    label: 'Top-down repo contract',
    body: 'Validate the repository as a system: shape, naming, required files, forbidden paths, direct-child limits, and docs conventions.',
    command: 'assura check',
  },
  {
    label: 'Agent feedback loop',
    body: 'Return bounded, repairable findings agents can act on without more prompting: what drifted, why it matters, and how to fix it.',
    command: 'assura check --format agent --agent codex',
  },
  {
    label: 'Hooks and merge gates',
    body: 'Nudge during active edits, warn before commit, and block real drift before merge using the same local contract.',
    command: 'assura hooks',
  },
  {
    label: 'Fast enough for loops',
    body: 'Keep checks cheap enough for local work and agent harnesses, with checked performance evidence instead of vague claims.',
    command: 'assura performance-report',
  },
  {
    label: 'Automation reports',
    body: 'Use text, JSON, YAML, status, advice, and agent outputs for CI, evidence, and developer feedback surfaces.',
    command: 'assura check --format json',
  },
  {
    label: 'Extension boundary',
    body: 'Start with language-agnostic repo health, then attach custom or language-specific constraints when the project needs them.',
    command: 'extensions.custom_constraints',
  },
];

const comparisons = [
  {
    label: 'Custom scripts',
    body: 'Useful for one-off checks, but they drift into bespoke glue. Assura gives the repo contract one config, one CLI, and standard reports.',
  },
  {
    label: 'ESLint, Biome, Ruff',
    body: 'Great inside source files. Assura sits above them, checking whether files, docs, generated output, and directories belong at all.',
  },
  {
    label: 'LS-Lint',
    body: 'Good for naming rules and a clean migration source. Assura extends the idea into top-down shape, required files, hooks, CI, and agent feedback.',
  },
  {
    label: 'Pre-commit and CI glue',
    body: 'Good delivery mechanisms, not the policy itself. Assura supplies the deterministic repo-level signal those hooks can run.',
  },
  {
    label: 'Policy engines',
    body: 'Powerful for broad governance, often heavy for edit loops. Assura keeps local repository health fast and developer-shaped.',
  },
  {
    label: 'Convention docs',
    body: 'Docs explain intent. Assura turns the same intent into timely, repairable feedback for humans and coding agents.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://assura.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://assura.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="theme-color" content="#0b0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" aria-label="Primary">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Assura home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>assura</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">Structure-first validation for developer workflows</p>
          <h1 id="hero-title">Your repo has a shape. Make it a contract.</h1>
          <p class="hero-copy">
            Assura is a fast local CLI that turns repository structure, naming,
            documentation conventions, and agent handoffs into checks that run before
            review.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="/guides/quickstart/">Start checking</a>
            <a class="button button-secondary" href="https://github.com/rothnic/assura">
              GitHub
            </a>
          </div>
          <ul class="hero-facts" aria-label="Assura product strengths">
            {heroFacts.map((fact) => <li>{fact}</li>)}
          </ul>
          <div class="command-strip" aria-label="Install command">
            <span>Install</span>
            <code>{installCommand}</code>
          </div>
          <div class="terminal hero-terminal" aria-label="Example assura review output">
            <div class="terminal-bar">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <strong>assura review</strong>
            </div>
            <pre><code>{terminalLines.map((line) => (
              <span class:list={['terminal-line', line.tone]}>{line.text || ' '}</span>
            ))}</code></pre>
          </div>
        </div>
      </section>

      <section class="section split-section" aria-labelledby="problem-title">
        <div class="section-copy">
          <p class="eyebrow">The problem</p>
          <h2 id="problem-title">Prose conventions do not survive fast edits.</h2>
          <p>
            Teams write down how a repo should be organized, then deadlines, new
            teammates, generated files, and coding agents slowly move the project away
            from that shape. Assura moves those expectations into a repo-local contract.
          </p>
        </div>
        <div class="stack-list" aria-label="Common structure drift problems">
          {
            problemPoints.map((point) => (
              <article class="line-card">
                <span aria-hidden="true"></span>
                <div>
                  <h3>{point.label}</h3>
                  <p>{point.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section contract-section" aria-labelledby="workflow-title">
        <div class="section-copy narrow">
          <p class="eyebrow">How it works</p>
          <h2 id="workflow-title">Start with the repo. Then go deeper.</h2>
          <p>
            Assura starts above language tools with the repository contract, then
            layers fast branch, worktree, agent, and project-specific signals around it.
          </p>
        </div>
        <div class="contract-stage">
          <div class="contract-stack" aria-label="Assura validation layers">
            {
              contractLayers.map((layer) => (
                <article class="contract-layer">
                  <div>
                    <span>{layer.label}</span>
                    <h3>{layer.title}</h3>
                    <p>{layer.body}</p>
                  </div>
                  <code>{layer.signal}</code>
                </article>
              ))
            }
          </div>
          <aside class="review-snapshot" aria-label="Compact assura review signal">
            <div class="snapshot-topline">
              <span>assura review</span>
              <strong>needs-review</strong>
            </div>
            <div class="snapshot-metrics">
              {
                reviewSignals.map((signal) => (
                  <div>
                    <span>{signal.label}</span>
                    <strong>{signal.value}</strong>
                    <small>{signal.detail}</small>
                  </div>
                ))
              }
            </div>
            <div class="snapshot-flow" aria-label="Signal flow">
              <span>shape</span>
              <span>branch</span>
              <span>worktree</span>
              <span>agent</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="section agent-section" aria-labelledby="agent-title">
        <div class="feedback-panel" aria-label="Decoded agent feedback example">
          <div class="feedback-topline">
            <span>agent feedback</span>
            <code>assura check --format agent</code>
          </div>
          <div class="feedback-status">
            <span aria-hidden="true"></span>
            <div>
              <p>Repo drift detected</p>
              <strong>Generated output escaped the repo contract.</strong>
            </div>
          </div>
          <dl class="feedback-list">
            <div>
              <dt>Where</dt>
              <dd><code>src/tmp.log</code></dd>
            </div>
            <div>
              <dt>Why</dt>
              <dd>This project uses a closed-world structure policy.</dd>
            </div>
            <div>
              <dt>Fix</dt>
              <dd>Remove the file or declare the path in <code>.assura/config.yml</code>.</dd>
            </div>
          </dl>
          <div class="feedback-note">
            Raw JSON stays available for harnesses; the message an agent needs is this small.
          </div>
        </div>
        <div class="section-copy">
          <p class="eyebrow">Built for the agent era</p>
          <h2 id="agent-title">Guardrails your coding agents can actually read.</h2>
          <p>
            Assura emits precise, machine-actionable findings. Run it inside the
            editing loop and the agent sees what changed, why it failed, and what
            concrete repair would satisfy the repository contract.
          </p>
          <a class="text-link" href="/guides/agent-ready-onboarding/">Read agent onboarding</a>
        </div>
      </section>

      <section class="section capability-section" aria-labelledby="capability-title">
        <div class="section-copy narrow">
          <p class="eyebrow">What Assura adds</p>
          <h2 id="capability-title">One repo-level safety layer before specialized tools.</h2>
          <p>
            Assura starts with general-purpose repository health and safety. Language
            linters, custom checks, and deeper policy hooks can layer on after the
            top-down contract is stable.
          </p>
        </div>
        <div class="capability-grid">
          {
            capabilities.map((capability) => (
              <article class="capability-card">
                <h3>{capability.label}</h3>
                <p>{capability.body}</p>
                <code>{capability.command}</code>
              </article>
            ))
          }
        </div>
      </section>

      <section id="compare" class="section comparison-section" aria-labelledby="comparison-title">
        <div class="section-copy narrow">
          <p class="eyebrow">Where it fits</p>
          <h2 id="comparison-title">Comparable tools solve pieces of the problem.</h2>
          <p>
            Keep the tools that already work. Assura covers the fast, language-agnostic
            repo contract they usually leave implicit, then hands clean signals to
            hooks, CI, agents, and specialized linters.
          </p>
        </div>
        <div class="comparison-grid">
          {
            comparisons.map((comparison) => (
              <article class="comparison-card">
                <h3>{comparison.label}</h3>
                <p>{comparison.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section final-section" aria-labelledby="final-title">
        <div>
          <p class="eyebrow">Start small</p>
          <h2 id="final-title">Install, initialize, and make drift visible.</h2>
        </div>
        <div class="final-actions">
          <a class="button button-primary" href="/guides/installation/">Install Assura</a>
          <a class="button button-secondary surface" href="/guides/quickstart/">
            Quickstart
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    color-scheme: light;
    --page-bg: #fafafa;
    --page-bg-soft: #f4f4f5;
    --surface: #ffffff;
    --surface-muted: #f5f5f5;
    --text: #18181b;
    --muted: #52525b;
    --soft: #71717a;
    --border: rgba(24, 24, 27, 0.13);
    --border-strong: rgba(24, 24, 27, 0.22);
    --primary: #0f766e;
    --primary-strong: #115e59;
    --primary-soft: rgba(15, 118, 110, 0.1);
    --info: #2563eb;
    --danger: #dc2626;
    --warning: #b45309;
    --shadow: rgba(24, 24, 27, 0.08);
    --hero-text: #101113;
    --hero-muted: #3f3f46;
    --header-bg: rgba(250, 250, 250, 0.82);
    --terminal-bg: #111315;
    --terminal-border: rgba(255, 255, 255, 0.11);
    --terminal-text: #f4f4f5;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      color-scheme: dark;
      --page-bg: #0b0c0d;
      --page-bg-soft: #101213;
      --surface: #111314;
      --surface-muted: #171a1b;
      --text: #f4f4f5;
      --muted: #a1a1aa;
      --soft: #71717a;
      --border: rgba(244, 244, 245, 0.13);
      --border-strong: rgba(244, 244, 245, 0.24);
      --primary: #5eead4;
      --primary-strong: #99f6e4;
      --primary-soft: rgba(94, 234, 212, 0.12);
      --info: #93c5fd;
      --danger: #f87171;
      --warning: #fbbf24;
      --shadow: rgba(0, 0, 0, 0.34);
      --hero-text: #f8fafc;
      --hero-muted: #d4d4d8;
      --header-bg: rgba(11, 12, 13, 0.82);
      --terminal-bg: #08090a;
      --terminal-border: rgba(255, 255, 255, 0.12);
      --terminal-text: #f4f4f5;
    }
  }

  :global(html) {
    min-width: 320px;
    background: var(--page-bg);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background:
      linear-gradient(180deg, transparent 0, var(--page-bg) 42rem),
      var(--page-bg);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  :global(a) {
    color: inherit;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(p),
  :global(code) {
    overflow-wrap: anywhere;
  }

  .skip-link {
    position: fixed;
    z-index: 40;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    border: 1px solid var(--border-strong);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(18px);
  }

  .header-inner,
  .hero-content,
  .section {
    width: min(100% - 2rem, 1120px);
    margin: 0 auto;
  }

  .header-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand,
  .nav-links {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    gap: 0.65rem;
    min-width: 0;
    text-decoration: none;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 1rem;
    font-weight: 800;
  }

  .brand-mark {
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid color-mix(in srgb, var(--primary) 52%, transparent);
    border-radius: 0.45rem;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--primary) 30%, transparent), transparent 58%),
      var(--surface);
    box-shadow: inset 0 0 0 0.32rem var(--primary-soft);
  }

  .nav-links {
    gap: 0.2rem;
    min-width: 0;
  }

  .nav-links a {
    border-radius: 0.45rem;
    padding: 0.52rem 0.68rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links a:hover {
    background: var(--surface-muted);
    color: var(--text);
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.4rem, 5vw, 3.8rem) 0 clamp(1.6rem, 3.5vw, 2.6rem);
  }

  .hero-image {
    position: absolute;
    z-index: -4;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.24;
    filter: grayscale(0.85) saturate(0.35) contrast(1.08);
  }

  .hero-overlay {
    position: absolute;
    z-index: -3;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--page-bg) 74%, transparent), var(--page-bg) 88%),
      color-mix(in srgb, var(--page-bg) 68%, transparent);
  }

  .hero-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--text) 7%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--text) 7%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, black, transparent 82%);
    opacity: 0.56;
  }

  .hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--primary);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 15ch;
    margin-bottom: 0;
    color: var(--hero-text);
    font-size: clamp(2.65rem, 5.2vw, 4.75rem);
    font-weight: 720;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .hero-copy {
    max-width: 43rem;
    margin: 1rem auto 0;
    color: var(--hero-muted);
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.62;
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-actions {
    margin-top: 1.3rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.78rem 1rem;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 740;
    line-height: 1;
    white-space: nowrap;
  }

  .button-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 0.8rem 2rem color-mix(in srgb, var(--primary) 20%, transparent);
  }

  .button-primary:hover {
    background: var(--primary-strong);
  }

  .button-secondary {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--text);
    backdrop-filter: blur(14px);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
  }

  @media (prefers-color-scheme: dark) {
    .button-primary {
      color: #06201c;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.1rem;
    margin: 1rem 0 0;
    padding: 0;
    color: var(--muted);
    list-style: none;
    font-size: 0.9rem;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-facts li::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--primary);
    content: "";
  }

  .command-strip {
    display: grid;
    width: min(100%, 47rem);
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    margin-top: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    padding: 0.68rem 0.78rem;
    box-shadow: 0 1px 2px var(--shadow);
    text-align: left;
    backdrop-filter: blur(16px);
  }

  .command-strip span {
    color: var(--soft);
    font-size: 0.78rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .command-strip code {
    min-width: 0;
    color: var(--text);
