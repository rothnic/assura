---
import heroImage from '../assets/assura-landing-hero.webp';

const pageTitle = 'Assura | Catch project drift before review';
const pageDescription =
  'Assura gives AI coding agents early warning signals about project structure, branch heat, docs, references, and policy drift before cleanup gets expensive.';

const installScriptUrl = 'https://assura.dev/install.sh';
const installCommand = `curl -fsSL ${installScriptUrl} | sh`;

const agentSetupPrompt = `Install Assura in this repository and set it up for agent-ready checks.
If assura is not installed, run:
ASSURA_INSTALL=${installScriptUrl}
curl -fsSL "$ASSURA_INSTALL" | sh

Then run:
assura agent onboard . --agent auto --format json
assura check --format json .

Read .assura/onboarding/agent-next.md, summarize what is active, what is inactive, and what questions need human answers before adding project-specific rules.`;

const navItems = [
  { label: 'Docs', href: '/guides/quickstart/' },
  { label: 'Compare', href: '#compare' },
  { label: 'Onboard', href: '#onboard' },
  { label: 'Performance', href: '/reference/performance/' },
  { label: 'GitHub', href: 'https://github.com/rothnic/assura' },
];

const heroFacts = [
  'Fast local checks',
  'Branch-aware review',
  'Thresholded signals',
  'Warn before commit',
  'Gate before merge',
];

const lateWorkflow = [
  'Agent changes 18 files',
  'Hooks fail after the batch',
  'Agent rushes a broad refactor',
  'Commit passes with debt',
];

const earlyWorkflow = [
  'Agent changes files',
  'Assura shows hot spots early',
  'Agent makes small repairs',
  'Review stays focused',
];

const reviewLines = [
  { text: '$ assura review --base auto', tone: 'prompt' },
  { text: 'Status: needs attention', tone: 'plain' },
  { text: 'Base: origin/main', tone: 'muted' },
  { text: '', tone: 'plain' },
  { text: 'Branch: 8 files | +412/-96 | 3 commits', tone: 'info' },
  { text: 'Worktree: 2 mod | 1 untracked | +74/-18', tone: 'info' },
  { text: '', tone: 'plain' },
  { text: 'Signals (! warn, ~ watch)', tone: 'plain' },
  { text: '! src/cli/          82/70  508 lines', tone: 'warn' },
  { text: '~ website/src/      48/35  link risk', tone: 'info' },
  { text: '~ .agents/skills/   36/35  missing section', tone: 'info' },
  { text: '', tone: 'plain' },
  { text: 'Hidden: 21 unchanged/generated paths', tone: 'muted' },
  { text: 'Next: assura review --path src/cli --explain', tone: 'pass' },
];

const heroReviewLines = [
  { text: '$ assura review --base auto', tone: 'prompt' },
  { text: 'Status: needs attention', tone: 'plain' },
  { text: 'Branch: 8 files | +412/-96 | 3 commits', tone: 'info' },
  { text: 'Worktree: 2 mod | 1 untracked | +74/-18', tone: 'info' },
  { text: '', tone: 'plain' },
  { text: 'Signals (! warn, ~ watch)', tone: 'plain' },
  { text: '! src/cli/        82/70  508 lines', tone: 'warn' },
  { text: '~ website/src/    48/35  link risk', tone: 'info' },
  { text: '', tone: 'plain' },
  { text: 'Hidden: 21 unchanged/generated', tone: 'muted' },
  { text: 'Next: assura review --path src/cli --explain', tone: 'pass' },
];

const reviewMetrics = [
  { label: 'New risk', value: '3', detail: 'hot areas' },
  { label: 'Branch', value: '8 files', detail: '+412 / -96 lines' },
  { label: 'Worktree', value: '2 modified', detail: '1 untracked' },
  { label: 'Noise hidden', value: '21', detail: 'unchanged or generated' },
];

const problemSignals = [
  {
    label: 'Small drift',
    body: 'A new helper lands in the wrong folder, docs reference an old path, or generated output escapes its boundary.',
  },
  {
    label: 'Hook pressure',
    body: 'Git hooks fire after the batch, so the agent optimizes for a green commit instead of evaluating the right refactor.',
  },
  {
    label: 'Rushed repair',
    body: 'A fix that could have moved one file becomes a wide patch that passes checks but leaves structural debt.',
  },
];

const comparisons = [
  {
    label: 'Language linters',
    misses:
      'Strong inside one runtime, but not a single fast policy for line counts, Markdown, config, docs, generated files, and agent instructions.',
    fit:
      'Assura handles language-agnostic file and project hygiene first, then lets language-specific checks attach by layer.',
  },
  {
    label: 'LS-Lint',
    misses:
      'Fast filesystem naming, not file contents. No shared rule bundles, rule-specific repair advice, or agent-ready feedback.',
    fit:
      'Assura keeps the structure speed and adds content-aware checks, reusable policy layers, and concrete fixes.',
  },
  {
    label: 'Pre-commit',
    misses:
      'A runner, not a signal model. It fires after a batch and passes through whatever each tool prints.',
    fit:
      'Assura can show thresholds earlier, warn before commit, and use the same bounded policy as a gate.',
  },
  {
    label: 'CI',
    misses: 'Finds problems after push.',
    fit: 'Assura gives branch and worktree signals before the failure leaves the machine.',
  },
  {
    label: 'Custom scripts',
    misses:
      'Can count lines or enforce conventions, but often become slow bespoke glue with repeated config and inconsistent output.',
    fit:
      'Assura gives one efficient CLI, one report shape, reusable rules, and stable automation output.',
  },
  {
    label: 'Convention docs',
    misses:
      'Explain intent, but cannot identify the changed line, failing rule, or expected repair.',
    fit: 'Assura turns that intent into visible, repairable signals agents can act on.',
  },
];

const signalFamilies = [
  {
    label: 'Structure fit',
    body: 'New top-level paths, folder growth, required files, naming drift, and generated-output boundaries.',
  },
  {
    label: 'Change heat',
    body: 'Files changed since base, line churn, untracked paths, renames, commits, and hot directories.',
  },
  {
    label: 'Knowledge drift',
    body: 'Docs, references, agent guidance, skill indexes, stale links, and unchecked content models.',
  },
  {
    label: 'Extension hooks',
    body: 'Project-specific and language-specific checks attach after the broad project layer is stable.',
  },
];

const lifecycleStages = [
  {
    label: 'Watch',
    status: 'while editing',
    body: 'Show values approaching their threshold before they become policy failures.',
  },
  {
    label: 'Warn',
    status: 'before commit',
    body: 'Show new, worsened, and changed-file findings without repeating old background noise.',
  },
  {
    label: 'Gate',
    status: 'before merge',
    body: 'Block only the serious configured policy violations that should not land.',
  },
];

const onboardingCreates = [
  '.assura/config.yml',
  'AGENTS.md guidance',
  '.agents/skills/',
  'onboarding packet',
  'watch / warn / gate profile',
];

const onboardingOpen = [
  'language and framework rules',
  'project-specific naming',
  'domain content models',
  'source-document custody',
  'human decisions still needed',
];

const performanceLayers = [
  {
    label: '0',
    title: 'Git and worktree scan',
    body: 'Find changed paths, line churn, untracked files, and the source branch first.',
  },
  {
    label: '1',
    title: 'Structure on affected areas',
    body: 'Run cheap project-shape checks where edits can actually change the answer.',
  },
  {
    label: '2',
    title: 'Docs and references',
    body: 'Layer markdown, frontmatter, links, and project-context checks when they are relevant.',
  },
  {
    label: '3',
    title: 'Gates and extensions',
    body: 'Run deeper custom or language-specific checks when the workflow moves toward commit or merge.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://assura.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://assura.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="theme-color" content="#0b0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfb" media="(prefers-color-scheme: light)" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" aria-label="Primary">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Assura home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 28 28" focusable="false">
              <path d="M7.2 14.6 11.7 19 21 8.8"></path>
            </svg>
          </span>
          <span>assura</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-content">
          <div class="hero-copy-block">
            <p class="eyebrow">Early warning signals for AI-assisted work</p>
            <h1 id="hero-title">Catch project drift before review.</h1>
            <p class="hero-copy">
              AI agents change projects faster than teams can review them.
              Assura turns structure, docs, references, and branch changes into
              early warnings before drift becomes failed hooks, broken CI, or rushed
              cleanup refactors.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <button
                class="button button-primary"
                type="button"
                data-copy-target="agent-prompt"
                data-copied-label="Prompt copied"
              >
                Copy agent prompt
              </button>
              <button
                class="button button-secondary"
                type="button"
                data-copy-target="install-command"
                data-copied-label="Command copied"
              >
                Copy install command
              </button>
            </div>
            <div id="start-command" class="start-panel" aria-label="Agent setup prompt and install command">
              <div class="start-panel-head">
                <div>
                  <span>Agent prompt</span>
                  <strong>Install and set up Assura</strong>
                </div>
                <a href="#review-output">See review output</a>
              </div>
              <pre><code id="agent-prompt">{agentSetupPrompt}</code></pre>
              <div class="install-row">
                <span>Manual install</span>
                <code id="install-command">{installCommand}</code>
                <button
                  class="copy-inline"
                  type="button"
                  data-copy-target="install-command"
                  data-copied-label="Copied"
                >
                  Copy
                </button>
              </div>
            </div>
            <ul class="hero-facts" aria-label="Assura product strengths">
              {heroFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>

          <div class="hero-visual" aria-label="Late cleanup versus early Assura signal">
            <div class="workflow-board">
              <article class="workflow-lane late-lane">
                <h2>Without Assura</h2>
                <ol>
                  {lateWorkflow.map((step) => <li>{step}</li>)}
                </ol>
              </article>
              <article class="workflow-lane signal-lane">
                <h2>With Assura</h2>
                <ol>
                  {earlyWorkflow.map((step) => <li>{step}</li>)}
                </ol>
              </article>
            </div>
            <div class="review-terminal">
              <div class="terminal-bar">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <strong>assura review --base auto</strong>
              </div>
              <pre><code>{heroReviewLines.map((line) => (
                <span class:list={['terminal-line', line.tone]}>{line.text || ' '}</span>
              ))}</code></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="section problem-section" aria-labelledby="problem-title">
        <div class="section-head">
          <p class="eyebrow">The problem</p>
          <h2 id="problem-title">The current workflow catches problems too late.</h2>
          <p>
            Teams layer naming linters, code linters, custom scripts, hooks, CI, and
            convention docs. Each tool sees a slice. Agents often hit the combined
            wall only after a large batch of work, when the pressure is to make the
            commit pass instead of choosing the right repair.
          </p>
        </div>
        <div class="problem-grid" aria-label="Late project drift cost">
          {problemSignals.map((point) => (
            <article class="signal-card">
              <h3>{point.label}</h3>
              <p>{point.body}</p>
            </article>
          ))}
        </div>
        <div class="cost-line" aria-label="Cost of fixing drift over time">
          <span>edit</span>
          <span>small drift</span>
          <span>drift grows</span>
          <span>hook blocks</span>
          <span>rushed refactor</span>
          <span>debt lands</span>
        </div>
      </section>

      <section id="compare" class="section comparison-section" aria-labelledby="compare-title">
        <div class="section-head compact">
          <p class="eyebrow">Where it fits</p>
          <h2 id="compare-title">One signal layer above your existing tools.</h2>
          <p>
            Assura does not replace linters, hooks, CI, or docs. It covers the
            language-agnostic signals they leave scattered: line counts, structure,
            docs, references, reusable rules, and repair guidance.
          </p>
        </div>
        <div class="comparison-grid">
          {comparisons.map((item) => (
            <article class="comparison-card">
              <div class="comparison-card-head">
                <span>Alternative</span>
                <h3>{item.label}</h3>
              </div>
              <dl>
                <div class="comparison-panel tool-panel">
                  <dt>Tool gap</dt>
                  <dd>{item.misses}</dd>
                </div>
                <div class="comparison-panel assura-panel">
                  <dt>Assura adds</dt>
                  <dd>{item.fit}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section id="review-output" class="section review-section" aria-labelledby="review-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">Show me the signal</p>
            <h2 id="review-title">A compact project map agents can act on.</h2>
          </div>
          <p>
            <code>assura review</code> compares the active branch or worktree to its
            source branch, rolls risk up by area, shows value and threshold, hides
            unchanged noise, and points to the next useful command.
          </p>
        </div>
        <div class="review-layout">
          <div class="review-terminal large">
            <div class="terminal-bar">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <strong>threshold report</strong>
            </div>
            <pre><code>{reviewLines.map((line) => (
              <span class:list={['terminal-line', line.tone]}>{line.text || ' '}</span>
            ))}</code></pre>
          </div>
          <div class="metric-grid" aria-label="Assura review summary">
            {reviewMetrics.map((metric) => (
              <article class="metric-card">
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
                <small>{metric.detail}</small>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section map-section" aria-labelledby="map-title">
        <div class="map-visual" aria-label="Top-down Assura signal model">
          <img
            class="map-texture"
            src={heroImage.src}
            width={heroImage.width}
            height={heroImage.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="map-layer project-layer">
            <span>Project baseline</span>
            <strong>structure, docs, agent readiness</strong>
          </div>
          <div class="map-layer branch-layer">
            <span>Active branch / worktree</span>
            <strong>changed files, line churn, hot directories</strong>
          </div>
          <div class="map-layer extension-layer">
            <span>Specialized extensions</span>
            <strong>language, content, release, domain checks</strong>
          </div>
        </div>
        <div class="section-head">
          <p class="eyebrow">Top down first</p>
          <h2 id="map-title">Assura watches the project as a whole.</h2>
          <p>
            Start with broad, language-agnostic health and safety. Then attach
            language or domain-specific checks only where file contents need deeper
            validation.
          </p>
        </div>
        <div class="family-grid">
          {signalFamilies.map((family) => (
            <article class="family-card">
              <h3>{family.label}</h3>
              <p>{family.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section lifecycle-section" aria-labelledby="lifecycle-title">
        <div class="section-head compact">
          <p class="eyebrow">Watch, warn, gate</p>
          <h2 id="lifecycle-title">Small fixes while the work is still small.</h2>
          <p>
            Assura separates advisory signals from merge blockers, so agents get
            timely feedback without turning every observation into a hard stop.
          </p>
        </div>
        <div class="lifecycle-grid">
          {lifecycleStages.map((stage) => (
            <article class="lifecycle-card">
              <div>
                <span>{stage.status}</span>
                <h3>{stage.label}</h3>
              </div>
              <p>{stage.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="onboard" class="section onboarding-section" aria-labelledby="onboard-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">Agent-ready onboarding</p>
            <h2 id="onboard-title">Checked is not the same as complete.</h2>
          </div>
          <p>
            Assura does not pretend unchecked behavior passed. It tells the agent
            what is active, what is inactive, and which human decisions are still
            needed before adding project-specific rules.
          </p>
        </div>
        <div class="onboarding-layout">
          <div class="command-panel">
            <code>$ assura agent onboard . --agent auto --format json</code>
            <p>
              Create or preserve a broad baseline, generate an onboarding packet, run
              local verification, and leave the next questions visible.
            </p>
          </div>
          <div class="check-columns">
            <article>
              <h3>Creates</h3>
              <ul>
                {onboardingCreates.map((item) => <li>{item}</li>)}
              </ul>
            </article>
            <article>
              <h3>Does not guess</h3>
              <ul>
                {onboardingOpen.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section performance-section" aria-labelledby="performance-title">
        <div class="section-head">
          <p class="eyebrow">Fast enough for the loop</p>
          <h2 id="performance-title">Cheap signals early. Deeper checks near gates.</h2>
          <p>
            Assura is designed to run while work is happening, not only after work is
            done. It starts as fast structural linting and grows into an incremental
            project signal layer.
          </p>
        </div>
        <div class="layer-list">
          {performanceLayers.map((layer) => (
            <article class="layer-row">
              <span>{layer.label}</span>
              <div>
                <h3>{layer.title}</h3>
                <p>{layer.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section final-section" aria-labelledby="final-title">
        <div>
          <p class="eyebrow">Start small</p>
          <h2 id="final-title">Give your agent one local project signal.</h2>
        </div>
        <div class="final-actions">
          <a class="button button-primary" href="/guides/installation/">Install Assura</a>
          <a class="button button-secondary surface" href="/guides/agent-ready-onboarding/">
            Read onboarding
          </a>
        </div>
      </section>
    </main>
    <footer class="site-footer" aria-label="Site footer">
      <div class="footer-inner">
        <p>
          Built by <a href="https://nickroth.com/">Nick Roth</a>.
        </p>
        <nav class="footer-links" aria-label="Personal links">
          <a href="https://nickroth.com/">nickroth.com</a>
          <a href="https://www.linkedin.com/in/nicholasleeroth">LinkedIn</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      for (const button of document.querySelectorAll('[data-copy-target]')) {
        button.addEventListener('click', async () => {
          const targetId = button.getAttribute('data-copy-target');
          const target = targetId ? document.getElementById(targetId) : null;
          const value = target?.textContent?.trim();

          if (!value) return;

          await navigator.clipboard.writeText(value);
          const originalLabel = button.getAttribute('data-original-label') || button.textContent || '';
          button.setAttribute('data-original-label', originalLabel);
          button.textContent = button.getAttribute('data-copied-label') || 'Copied';
          window.setTimeout(() => {
            button.textContent = button.getAttribute('data-original-label') || originalLabel;
          }, 1600);
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    color-scheme: light;
    --page-bg: #f7faf9;
    --page-bg-soft: #edf4f2;
    --surface: #ffffff;
    --surface-muted: #f0f6f4;
    --surface-strong: #dde9e6;
    --text: #0d1716;
    --muted: #41524f;
    --soft: #667370;
    --border: rgba(13, 23, 22, 0.14);
    --border-strong: rgba(13, 23, 22, 0.24);
    --primary: #0f766e;
    --primary-strong: #0a5e58;
    --primary-soft: rgba(15, 118, 110, 0.12);
    --info: #2563eb;
    --info-soft: rgba(37, 99, 235, 0.1);
    --danger: #dc2626;
    --danger-soft: rgba(220, 38, 38, 0.1);
    --warning: #b45309;
    --warning-soft: rgba(180, 83, 9, 0.12);
    --shadow: rgba(7, 20, 18, 0.1);
    --terminal-bg: #0b0d0e;
    --terminal-border: rgba(255, 255, 255, 0.12);
    --terminal-text: #f4f4f5;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      color-scheme: dark;
      --page-bg: #0b0c0d;
      --page-bg-soft: #101213;
      --surface: #111314;
      --surface-muted: #171a1b;
      --surface-strong: #1f2425;
      --text: #f4f4f5;
      --muted: #a1a1aa;
      --soft: #71717a;
      --border: rgba(244, 244, 245, 0.13);
      --border-strong: rgba(244, 244, 245, 0.24);
      --primary: #5eead4;
      --primary-strong: #99f6e4;
      --primary-soft: rgba(94, 234, 212, 0.12);
      --info: #93c5fd;
      --info-soft: rgba(147, 197, 253, 0.13);
      --danger: #f87171;
      --danger-soft: rgba(248, 113, 113, 0.13);
      --warning: #fbbf24;
      --warning-soft: rgba(251, 191, 36, 0.13);
      --shadow: rgba(0, 0, 0, 0.34);
      --terminal-bg: #08090a;
      --terminal-border: rgba(255, 255, 255, 0.12);
      --terminal-text: #f4f4f5;
    }
  }

  :global(html) {
    min-width: 320px;
    background: var(--page-bg);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: var(--page-bg);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  :global(a) {
    color: inherit;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(p),
  :global(code),
  :global(dd) {
    overflow-wrap: anywhere;
  }

  .skip-link {
    position: fixed;
    z-index: 40;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    border: 1px solid var(--border-strong);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--page-bg) 84%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner,
  .hero-content,
  .section {
    width: min(100% - 2rem, 1120px);
    margin: 0 auto;
  }

  .header-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand,
  .nav-links {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    gap: 0.65rem;
    min-width: 0;
    text-decoration: none;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 1rem;
    font-weight: 800;
  }

  .brand-mark {
    position: relative;
    display: inline-grid;
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--primary) 52%, transparent);
    border-radius: 0.45rem;
    background:
      radial-gradient(circle at 28% 24%, color-mix(in srgb, #ffffff 36%, transparent), transparent 28%),
      linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--primary) 34%, var(--surface)) 68%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, #ffffff 18%, transparent),
      0 0.45rem 1rem color-mix(in srgb, var(--primary) 22%, transparent);
    color: #ffffff;
  }

  .brand-mark::before {
    position: absolute;
    inset: 0.24rem;
    border: 1px solid color-mix(in srgb, #ffffff 22%, transparent);
    border-radius: 0.27rem;
    background: color-mix(in srgb, #000000 10%, transparent);
    content: "";
  }

  .brand-mark svg {
    position: relative;
    z-index: 1;
    width: 1.05rem;
    height: 1.05rem;
  }

  .brand-mark path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3.2;
  }

  .nav-links {
    gap: 0.2rem;
    min-width: 0;
  }

  .nav-links a {
    border-radius: 0.45rem;
    padding: 0.52rem 0.68rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links a:hover {
    background: var(--surface-muted);
    color: var(--text);
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.2rem, 4.5vw, 3.4rem) 0 clamp(1.4rem, 3.2vw, 2.35rem);
  }

  .hero-grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--text) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--text) 6%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, black, transparent 84%);
    opacity: 0.42;
  }

  .hero-content {
    display: grid;
    gap: clamp(1.35rem, 3vw, 2rem);
    justify-items: center;
    text-align: center;
  }

  .hero-copy-block {
    display: grid;
    justify-items: center;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--primary);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 14ch;
    margin-bottom: 0;
    color: var(--text);
    font-size: clamp(2.7rem, 5.4vw, 5rem);
    font-weight: 730;
    letter-spacing: 0;
    line-height: 0.97;
  }

  .hero-copy {
    max-width: 48rem;
    margin: 1rem auto 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.62;
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-actions {
    margin-top: 1.3rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.78rem 1rem;
    text-decoration: none;
    font: inherit;
    font-size: 0.94rem;
    font-weight: 740;
    line-height: 1;
    white-space: nowrap;
  }

  button.button,
  .copy-inline {
    cursor: pointer;
  }

  .button-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 0.8rem 2rem color-mix(in srgb, var(--primary) 20%, transparent);
  }

  .button-primary:hover {
    background: var(--primary-strong);
  }

  .button-secondary {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--text);
    backdrop-filter: blur(14px);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
  }

  @media (prefers-color-scheme: dark) {
    .button-primary {
      color: #06201c;
    }
  }

  .start-panel {
    display: grid;
    width: min(100%, 58rem);
    gap: 0.75rem;
    margin-top: 1rem;
    border: 1px solid color-mix(in srgb, var(--primary) 28%, var(--border));
    border-radius: 0.58rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 86%, transparent), color-mix(in srgb, var(--surface-muted) 70%, transparent)),
      var(--surface);
    padding: 0.85rem;
    box-shadow: 0 1rem 2.6rem color-mix(in srgb, var(--shadow) 74%, transparent);
    text-align: left;
  }

  .start-panel-head {
    display: flex;
    min-width: 0;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .start-panel-head > div {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .start-panel-head span,
  .install-row span {
    color: var(--primary);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .start-panel-head strong {
    color: var(--text);
    font-size: 0.96rem;
    line-height: 1.25;
  }

  .start-panel-head a {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 720;
    text-decoration: none;
  }

  .start-panel-head a:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .start-panel pre {
    margin: 0;
    overflow-x: auto;
    border: 1px solid var(--terminal-border);
    border-radius: 0.46rem;
    background: var(--terminal-bg);
    padding: 0.78rem;
    color: var(--terminal-text);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.74rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .install-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 0.72rem;
  }

  .install-row code {
    min-width: 0;
    overflow-x: auto;
    color: var(--text);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.72rem;
    line-height: 1.35;
    white-space: nowrap;
  }

  .copy-inline {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 0.42rem;
    background: var(--surface);
    padding: 0.45rem 0.62rem;
    color: var(--text);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 760;
    line-height: 1;
  }

  .copy-inline:hover {
    border-color: color-mix(in srgb, var(--primary) 46%, var(--border));
    color: var(--primary);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.1rem;
    margin: 1rem 0 0;
    padding: 0;
    color: var(--muted);
    list-style: none;
    font-size: 0.9rem;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-facts li::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--primary);
    content: "";
  }

  .hero-visual {
    display: grid;
    width: min(100%, 60rem);
    gap: 0.9rem;
    text-align: left;
  }

  .workflow-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .workflow-lane {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: 0 1px 2px var(--shadow);
  }

  .workflow-lane h2 {
    margin: 0;
    border-bottom: 1px solid var(--border);
    padding: 0.82rem 0.95rem;
    color: var(--text);
    font-size: 0.94rem;
    line-height: 1.2;
  }

  .workflow-lane ol {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0.95rem;
    list-style: none;
    counter-reset: workflow;
  }

  .workflow-lane li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.42;
  }

  .workflow-lane li::before {
    display: inline-flex;
    width: 1.45rem;
    height: 1.45rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--soft);
    content: counter(workflow);
    counter-increment: workflow;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .late-lane {
    border-color: color-mix(in srgb, var(--danger) 30%, var(--border));
  }

  .late-lane li::before {
    background: var(--danger-soft);
    color: var(--danger);
  }

  .signal-lane {
    border-color: color-mix(in srgb, var(--primary) 36%, var(--border));
  }

  .signal-lane li::before {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .review-terminal,
  .command-panel {
    position: relative;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--terminal-border) 82%, var(--primary));
    border-radius: 0.5rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-muted) 24%, transparent), transparent 42%),
      var(--terminal-bg);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, #ffffff 8%, transparent),
      0 1.25rem 3rem var(--shadow);
    color: var(--terminal-text);
    text-align: left;
  }

  .review-terminal::before,
  .command-panel::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--primary) 10%, transparent), transparent 38%),
      radial-gradient(circle at 18% 0%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 32%);
    content: "";
    opacity: 0.58;
    pointer-events: none;
  }

  .review-terminal.large {
    align-self: start;
  }

  .terminal-bar {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.42rem;
    border-bottom: 1px solid var(--terminal-border);
    background: color-mix(in srgb, var(--surface-muted) 42%, transparent);
    padding: 0.72rem 0.85rem;
  }

  .terminal-bar span {
    width: 0.72rem;
    height: 0.72rem;
    flex: 0 0 auto;
    border-radius: 999px;
  }

  .terminal-bar span:nth-child(1) {
    background: var(--danger);
  }

  .terminal-bar span:nth-child(2) {
    background: var(--warning);
  }

  .terminal-bar span:nth-child(3) {
    background: var(--primary);
  }

  .terminal-bar strong {
    min-width: 0;
    margin-left: 0.35rem;
    color: color-mix(in srgb, var(--terminal-text) 76%, transparent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.76rem;
    font-weight: 680;
    overflow-wrap: anywhere;
  }

  .review-terminal pre {
    position: relative;
    margin: 0;
    overflow-x: auto;
    padding: 0.82rem;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.42;
  }

  .review-terminal pre code {
    display: grid;
    gap: 0.16rem;
  }

  .terminal-line {
    display: block;
    border-radius: 0.32rem;
    min-width: max-content;
    padding: 0.08rem 0.42rem 0.1rem;
    white-space: pre;
  }

  .terminal-line.prompt {
    color: var(--primary);
    font-weight: 760;
  }

  .terminal-line.pass {
    background: color-mix(in srgb, var(--primary-soft) 44%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 22%, transparent);
    color: var(--primary);
    font-weight: 760;
  }

  .terminal-line.warn {
    background: color-mix(in srgb, var(--warning-soft) 62%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--warning) 24%, transparent);
    color: var(--warning);
    font-weight: 760;
  }

  .terminal-line.fail {
    background: color-mix(in srgb, var(--danger-soft) 64%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--danger) 24%, transparent);
    color: var(--danger);
    font-weight: 760;
  }

  .terminal-line.info {
    background: color-mix(in srgb, var(--info-soft) 45%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--info) 18%, transparent);
    color: var(--info);
  }

  .terminal-line.muted {
    background: color-mix(in srgb, var(--surface-muted) 40%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--terminal-text) 8%, transparent);
    color: color-mix(in srgb, var(--terminal-text) 58%, transparent);
  }

  .terminal-line.plain {
    color: color-mix(in srgb, var(--terminal-text) 88%, transparent);
    font-weight: 700;
  }

  .section {
    padding: clamp(3.25rem, 7vw, 5.7rem) 0;
  }

  .problem-section,
  .review-section,
  .lifecycle-section,
  .performance-section {
    border-bottom: 1px solid var(--border);
  }

  .comparison-section,
  .onboarding-section {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--page-bg-soft);
  }

  .map-section {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    max-width: 48rem;
    min-width: 0;
  }

  .section-head.compact {
    max-width: 44rem;
  }

  .section-head.split {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 0.9fr);
    gap: clamp(1rem, 4vw, 2.5rem);
    align-items: end;
  }

  .section-head h2,
  .final-section h2 {
    margin-bottom: 0;
    color: var(--text);
    font-size: clamp(2rem, 4.3vw, 4rem);
    font-weight: 710;
    letter-spacing: 0;
    line-height: 1;
  }

  .section-head p {
    max-width: 43rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.72;
  }

  .section-head.split > p {
    margin: 0;
  }

  .problem-grid,
  .comparison-grid,
  .family-grid,
  .lifecycle-grid {
    display: grid;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .problem-grid,
  .family-grid,
  .lifecycle-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .comparison-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .signal-card,
  .comparison-card,
  .family-card,
  .lifecycle-card,
  .metric-card,
  .check-columns article {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    padding: 1rem;
    box-shadow: 0 1px 2px var(--shadow);
  }

  .signal-card h3,
  .comparison-card h3,
  .family-card h3,
  .lifecycle-card h3,
  .layer-row h3,
  .check-columns h3 {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .signal-card p,
  .comparison-card dd,
  .family-card p,
  .lifecycle-card p,
  .layer-row p,
  .command-panel p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  .cost-line {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.35rem;
    align-items: stretch;
    margin-top: 1rem;
  }

  .cost-line span {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 720;
    line-height: 1.25;
    text-align: center;
  }

  .cost-line span:first-child {
    border-radius: 0.5rem 0 0 0.5rem;
  }

  .cost-line span:last-child {
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--danger-soft);
    color: var(--danger);
  }

  .cost-line span:nth-child(2),
  .cost-line span:nth-child(3) {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .cost-line span:nth-child(4),
  .cost-line span:nth-child(5) {
    background: var(--warning-soft);
    color: var(--warning);
  }

  .comparison-card {
    display: grid;
    gap: 0.82rem;
    padding: 0.85rem;
  }

  .comparison-card-head {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .comparison-card-head span {
    order: 2;
    flex: 0 0 auto;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-muted) 80%, transparent);
    padding: 0.24rem 0.44rem;
    color: var(--soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .comparison-card dl {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .comparison-panel {
    display: grid;
    gap: 0.32rem;
    border: 1px solid var(--border);
    border-radius: 0.46rem;
    padding: 0.75rem 0.78rem;
  }

  .tool-panel {
    background: color-mix(in srgb, var(--surface-muted) 58%, transparent);
  }

  .assura-panel {
    border-color: color-mix(in srgb, var(--primary) 34%, var(--border));
    background: color-mix(in srgb, var(--primary-soft) 36%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .comparison-card dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .comparison-card dt::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--soft);
    content: "";
  }

  .tool-panel dt {
    color: var(--warning);
  }

  .tool-panel dt::before {
    background: var(--warning);
  }

  .assura-panel dt {
    color: var(--primary);
  }

  .assura-panel dt::before {
    background: var(--primary);
  }

  .comparison-card dd {
    margin-left: 0;
  }

  .review-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(16rem, 0.68fr);
    gap: 1rem;
    align-items: start;
    margin-top: 2rem;
  }

  .metric-grid {
    display: grid;
    gap: 0.8rem;
  }

  .metric-card {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    padding: 0.85rem;
    box-shadow: 0 1px 2px var(--shadow);
  }

  .metric-card span,
  .map-layer span,
  .lifecycle-card span {
    color: var(--primary);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .metric-card strong {
    color: var(--text);
    font-size: 1.65rem;
