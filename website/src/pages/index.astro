---
import AgentSetupDialog from '../components/marketing/agent-setup-dialog.astro';
import CommandJourney from '../components/marketing/command-journey.astro';
import ComparisonTable from '../components/marketing/comparison-table.astro';
import MarketingLayout from '../components/marketing/marketing-layout.astro';
import PerformanceProof from '../components/marketing/performance-proof.astro';
import PolicyTreeDemo from '../components/marketing/policy-tree-demo.astro';
import SectionHeading from '../components/marketing/section-heading.astro';
import TerminalCard from '../components/marketing/terminal-card.astro';
import {
  agentSetupPrompt, agentSetupSteps, installCommand, onboardingCommand,
  reviewCommand, releaseScope, releaseStatus, verificationCommand,
} from '../data/marketing';
import reviewDemo from '../data/review-demo.json';

const pageTitle = 'Assura | Make repository conventions executable';
const pageDescription = 'Assura gives coding agents precise feedback on project structure, naming and guidance, with the same local policy available in CI.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'SoftwareSourceCode'],
  name: 'Assura',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description: pageDescription,
  url: 'https://assura.dev/',
  codeRepository: 'https://github.com/rothnic/assura',
  license: ['https://opensource.org/license/mit', 'https://www.apache.org/licenses/LICENSE-2.0'],
  author: { '@type': 'Person', name: 'Nick Roth', url: 'https://www.nickroth.com/' },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
};
const navItems = [
  { label: 'How it works', href: '#review-output' },
  { label: 'Compare', href: '/compare/ls-lint/' },
  { label: 'Performance', href: '/performance/' },
  { label: 'Docs', href: '/guides/quickstart/', mobile: true },
  { label: 'GitHub', href: 'https://github.com/rothnic/assura' },
];
type TerminalTone = 'prompt' | 'plain' | 'muted' | 'info' | 'warn' | 'pass' | 'fail';
const heroReviewLines = reviewDemo.hero_lines as Array<{ text: string; tone: TerminalTone }>;
const onboardingApplied = [
  'project and agent harness detected',
  'editable policy added to the project',
  'agent guidance and onboarding packet',
];
const onboardingOpen = [
  'language and framework rules',
  'project-specific naming',
  'host activation and permissions',
];
const limits = [
  { label: 'Configured policy', status: 'Scope', body: 'A passing check covers the policies configured for that project. It does not certify software correctness.' },
  { label: 'Native tools', status: 'Complement', body: 'Keep language linters, type checks and tests. Assura supplies repository policy feedback alongside them.' },
  { label: 'Host activation', status: 'Verify', body: 'Watch and event feedback require a configured integration. Generated files alone do not prove that your host activated it.' },
];
---

<MarketingLayout title={pageTitle} description={pageDescription} canonicalPath="/"
  imagePath="/social/home.webp" navItems={navItems} structuredData={structuredData}>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title" data-release-surface="compact-review explicit-review-base">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="hero-copy-block">
          <p class="eyebrow">Repository policy for coding agents</p>
          <h1 id="hero-title">Make repository conventions executable.</h1>
          <p class="hero-copy">{pageDescription}</p>
          <p class="hero-example">A convention says “use kebab-case.” A check can name
            <code>UserMenu.ts</code>, explain the rule, and verify the rename to
            <code>user-menu.ts</code>.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#onboard" data-open-setup data-analytics-event="setup_open">Set up with your agent</a>
            <a class="button button-secondary" href="#review-output" data-analytics-event="review_example_click">See how rules apply</a>
          </div>
          <ul class="hero-facts" aria-label="Assura product strengths">
            <li>Project structure</li><li>File naming</li><li>Agent guidance</li><li>Local and CI policy</li>
          </ul>
        </div>
        <div class="hero-visual" aria-label="Generated Assura project review">
          <div class="release-route-status">
            <strong>Recorded source example</strong>
            <span>CLI, generator and fixture input revision: <code>{reviewDemo.source_revision}</code>.</span>
            <small>Source checkout output; published release output may differ.</small>
            <code>{reviewCommand}</code>
            <small>Example output below preserves the raw generated CLI evidence.</small>
          </div>
          <TerminalCard title={reviewDemo.command} lines={heroReviewLines} variant="review" />
        </div>
      </div>
    </section>

    <section class="section problem-section" aria-labelledby="problem-title">
      <div class="section-head compact">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title">Written conventions need a checkable counterpart.</h2>
        <p>A new file can use the wrong name or miss a required location even when
          its code works. Keep those repository conventions in project-owned
          configuration so a coding agent and CI can ask the same policy question.</p>
      </div>
    </section>

    <section id="review-output" class="section review-section" aria-labelledby="review-title"
      data-release-surface="structure-validation-cli configured-policy-gate markdown-common-lints markdown-local-link-checks markdown-rule-severity-suppression repository-reference-checks agent-guidance-contracts">
      <SectionHeading eyebrow="Config to feedback" title="A rule, a violation, and a verified rename." id="review-title" layout="split">
        <p>This runnable fixture uses the configuration shown below. The recorded
          check fails on one filename, then passes after that file is renamed.
          The policy and file contents stay the same.</p>
      </SectionHeading>
      <PolicyTreeDemo />
    </section>

    <section id="onboard" class="section onboarding-section" aria-labelledby="onboard-title"
      data-release-surface="agent-onboarding agent-integration-lifecycle agent-guidance-contracts">
      <div class="section-head split">
        <div>
          <p class="eyebrow">Version-aware start</p>
          <h2 id="onboard-title">Choose a version, then set up your project.</h2>
        </div>
        <p>Start with the published release. The project owns its policy;
          generated setup still needs deliberate specialization and host approval.</p>
      </div>
      <div class="onboarding-layout">
        <div class="command-panel">
          <strong>{releaseStatus}</strong>
          <code>$ {onboardingCommand}</code>
          <p>{releaseScope}</p>
          <a class="button button-primary" href="#onboard" data-open-setup data-analytics-event="setup_open">Start with your agent</a>
          <p>
            <a href="/guides/installation/#install-with-script">Published release installation</a>
          </p>
        </div>
        <div class="check-columns">
          <article>
            <h3>Detects and applies</h3>
            <ul>{onboardingApplied.map((item) => <li>{item}</li>)}</ul>
          </article>
          <article>
            <h3>Leaves undecided</h3>
            <ul>{onboardingOpen.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
      </div>
    </section>

    <section id="compare" class="section comparison-section" aria-labelledby="compare-title">
      <div id="map-title" class="section-head compact">
        <p class="eyebrow">Where it fits</p>
        <h2 id="compare-title">Repository conventions alongside your existing tools.</h2>
        <p>Native linters and tests remain necessary. Assura checks configured
          structure, naming and guidance; use language tools for code semantics
          and tests for application behavior. Hooks and CI can run both.</p>
      </div>
      <ComparisonTable />
      <CommandJourney />
    </section>

    <PerformanceProof />
    <section class="section lifecycle-section" aria-labelledby="lifecycle-title"
      data-release-surface="continuous-watch agent-daemon-nudges configured-policy-gate">
      <div class="section-head compact">
        <p class="eyebrow">Evidence and limitations</p>
        <h2 id="lifecycle-title">Every result has a scope.</h2>
        <p>The rename above is one recorded fixture result. Historical benchmarks
          do not establish current speed, and generated setup is not proof of
          active integration.</p>
      </div>
      <div class="lifecycle-grid">
        {limits.map((limit) => (
          <article class="lifecycle-card">
            <div><span>{limit.status}</span><h3>{limit.label}</h3></div>
            <p>{limit.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section final-section" aria-labelledby="final-title">
      <div>
        <p class="eyebrow">Feedback and creator</p>
        <h2 id="final-title">Bring a convention from your own repository.</h2>
      </div>
      <div class="final-actions">
        <a class="button button-primary" href="https://github.com/rothnic/assura/issues">Share feedback</a>
        <a class="button button-secondary surface" href="https://www.nickroth.com/">Meet Nick Roth</a>
        <a href="/guides/agent-ready-onboarding/" data-analytics-event="docs_click">Read onboarding</a>
      </div>
    </section>
  </main>
  <AgentSetupDialog steps={agentSetupSteps} prompt={agentSetupPrompt}
    onboardingCommand={onboardingCommand} installCommand={installCommand}
    releaseStatus={releaseStatus} releaseScope={releaseScope}
    verificationCommand={verificationCommand} />
</MarketingLayout>

<style>
  .release-route-status { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.55rem; min-width: 0; color: var(--muted); line-height: 1.45; }
  .release-route-status strong { overflow-wrap: anywhere; color: var(--text); }
  .release-route-status code { overflow-wrap: anywhere; color: var(--text); }
  .release-route-status small { color: var(--soft); }
  .hero-example { max-width: 52ch; color: var(--muted); line-height: 1.6; }
  .hero-example code { color: var(--text); }
  #compare > .journey-section { padding: 3rem 0 0; }
  #map-title { scroll-margin-top: 5.25rem; }
</style>
