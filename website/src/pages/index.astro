---
import heroImage from '../assets/assura-landing-hero.webp';

const pageTitle = 'Assura | Repository structure as a contract';
const pageDescription =
  'Assura is a fast local CLI that turns repository structure, naming, docs conventions, and agent handoffs into checkable contracts.';

const installCommand =
  'curl -fsSL https://raw.githubusercontent.com/rothnic/assura/master/website/public/install.sh | sh';

const navItems = [
  { label: 'Docs', href: '/guides/quickstart/' },
  { label: 'Roadmap', href: '/roadmap/' },
  { label: 'Performance', href: '/reference/performance/' },
  { label: 'GitHub', href: 'https://github.com/rothnic/assura' },
];

const heroFacts = [
  'Single Rust binary',
  'Deterministic local checks',
  'Agent-readable output',
];

const terminalLines = [
  { text: '$ assura check', tone: 'prompt' },
  { text: 'Assura structure check', tone: 'plain' },
  { text: '=======================', tone: 'muted' },
  { text: 'Files checked: 1561', tone: 'plain' },
  { text: 'Directories checked: 353', tone: 'plain' },
  { text: 'Violations: 0', tone: 'pass' },
  { text: '', tone: 'plain' },
  { text: 'All configured structure checks passed.', tone: 'pass' },
];

const problemPoints = [
  {
    label: 'Structure drift',
    body: 'Stray files, misnamed modules, and phantom directories accumulate one pull request at a time.',
  },
  {
    label: 'Agent speed',
    body: 'Coding agents can create more files in one pass than a reviewer can police by hand.',
  },
  {
    label: 'Docs are not gates',
    body: 'CONTRIBUTING.md explains the convention. Assura makes the same convention executable.',
  },
];

const workflow = [
  {
    step: '01',
    title: 'Declare shape',
    body: 'Capture naming, required files, forbidden paths, and closed-world boundaries in .assura/config.yml.',
  },
  {
    step: '02',
    title: 'Check everywhere',
    body: 'Run the same contract locally, in hooks, in CI, or inside an agent loop.',
  },
  {
    step: '03',
    title: 'Return repairable output',
    body: 'Text, JSON, YAML, status, advice, and agent reports give each workflow the right level of detail.',
  },
];

const capabilities = [
  {
    label: 'Structure validation',
    body: 'File and directory naming, required files, forbidden entries, child-count limits, and repo shape.',
    command: 'assura check',
  },
  {
    label: 'LS-Lint migration',
    body: 'Convert supported LS-Lint 2.3 configs, then extend beyond naming-only policy.',
    command: 'assura migrate .ls-lint.yml',
  },
  {
    label: 'Agent feedback',
    body: 'Emit bounded, machine-actionable findings that Codex and other harnesses can use to self-correct.',
    command: 'assura check --format agent --agent codex',
  },
  {
    label: 'Automation reports',
    body: 'Use JSON, YAML, status, and advice outputs for CI, evidence, and developer feedback surfaces.',
    command: 'assura check --format json',
  },
  {
    label: 'Local hooks',
    body: 'Wire structure checks into advisory local loops and stronger merge gates without a hosted service.',
    command: 'assura hooks',
  },
  {
    label: 'Performance evidence',
    body: 'Keep validation speed visible with checked reports instead of vague performance claims.',
    command: 'assura performance-report',
  },
];

const comparisons = [
  {
    label: 'Code linters',
    body: 'Linters inspect what is inside files. Assura checks whether the files and directories themselves belong.',
  },
  {
    label: 'LS-Lint',
    body: 'LS-Lint checks names. Assura adds required files, forbidden paths, child limits, reports, and agent output.',
  },
  {
    label: 'Convention docs',
    body: 'Docs describe structure. Assura turns the same convention into a local pass or fail contract.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://assura.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://assura.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="theme-color" content="#0b0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" aria-label="Primary">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Assura home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>assura</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">Structure-first validation for developer workflows</p>
          <h1 id="hero-title">Your repo has a shape. Make it a contract.</h1>
          <p class="hero-copy">
            Assura is a fast local CLI that turns repository structure, naming,
            documentation conventions, and agent handoffs into checks that run before
            review.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="/guides/quickstart/">Start checking</a>
            <a class="button button-secondary" href="https://github.com/rothnic/assura">
              GitHub
            </a>
          </div>
          <ul class="hero-facts" aria-label="Assura product strengths">
            {heroFacts.map((fact) => <li>{fact}</li>)}
          </ul>
          <div class="command-strip" aria-label="Install command">
            <span>Install</span>
            <code>{installCommand}</code>
          </div>
          <div class="terminal hero-terminal" aria-label="Example assura check output">
            <div class="terminal-bar">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <strong>assura check</strong>
            </div>
            <pre><code>{terminalLines.map((line) => (
              <span class:list={['terminal-line', line.tone]}>{line.text || ' '}</span>
            ))}</code></pre>
          </div>
        </div>
      </section>

      <section class="section split-section" aria-labelledby="problem-title">
        <div class="section-copy">
          <p class="eyebrow">The problem</p>
          <h2 id="problem-title">Prose conventions do not survive fast edits.</h2>
          <p>
            Teams write down how a repo should be organized, then deadlines, new
            teammates, generated files, and coding agents slowly move the project away
            from that shape. Assura moves those expectations into a repo-local contract.
          </p>
        </div>
        <div class="stack-list" aria-label="Common structure drift problems">
          {
            problemPoints.map((point) => (
              <article class="line-card">
                <span aria-hidden="true"></span>
                <div>
                  <h3>{point.label}</h3>
                  <p>{point.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section workflow-section" aria-labelledby="workflow-title">
        <div class="section-copy narrow">
          <p class="eyebrow">How it works</p>
          <h2 id="workflow-title">A checkable path from first run to CI.</h2>
          <p>
            Start broad, keep the feedback local, and tighten the policy as the project
            learns which boundaries should be stable.
          </p>
        </div>
        <ol class="workflow-list">
          {
            workflow.map((item) => (
              <li>
                <span>{item.step}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section agent-section" aria-labelledby="agent-title">
        <div class="terminal" aria-label="Agent format check output">
          <div class="terminal-bar">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <strong>assura check --format agent</strong>
          </div>
          <pre><code><span class="terminal-line prompt">$ assura check --format agent --agent codex</span>
<span class="terminal-line plain">{'{'}</span>
<span class="terminal-line plain">  "hookSpecificOutput": {'{'}</span>
<span class="terminal-line muted">    "hookEventName": "UserPromptSubmit",</span>
<span class="terminal-line info">    "additionalContext": "&lt;assura-feedback&gt;..."</span>
<span class="terminal-line pass">    "Assura: pass; no structural feedback."</span>
<span class="terminal-line info">    "...&lt;/assura-feedback&gt;"</span>
<span class="terminal-line plain">  {'}'}</span>
<span class="terminal-line plain">{'}'}</span></code></pre>
        </div>
        <div class="section-copy">
          <p class="eyebrow">Built for the agent era</p>
          <h2 id="agent-title">Guardrails your coding agents can actually read.</h2>
          <p>
            Assura emits precise, machine-actionable findings. Run it inside the
            editing loop and the agent sees what changed, why it failed, and what
            concrete repair would satisfy the repository contract.
          </p>
          <a class="text-link" href="/guides/agent-ready-onboarding/">Read agent onboarding</a>
        </div>
      </section>

      <section class="section capability-section" aria-labelledby="capability-title">
        <div class="section-copy narrow">
          <p class="eyebrow">What ships</p>
          <h2 id="capability-title">The practical command surface.</h2>
          <p>
            Assura is intentionally local and boring: one CLI, explicit config, and
            report formats that fit developer tools you already use.
          </p>
        </div>
        <div class="capability-grid">
          {
            capabilities.map((capability) => (
              <article class="capability-card">
                <h3>{capability.label}</h3>
                <p>{capability.body}</p>
                <code>{capability.command}</code>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section comparison-section" aria-labelledby="comparison-title">
        <div class="section-copy narrow">
          <p class="eyebrow">Where it fits</p>
          <h2 id="comparison-title">The layer your toolchain is missing.</h2>
          <p>
            Assura does not replace code linters, docs, or reviews. It handles the
            structural contract those systems usually leave implicit.
          </p>
        </div>
        <div class="comparison-grid">
          {
            comparisons.map((comparison) => (
              <article class="comparison-card">
                <h3>{comparison.label}</h3>
                <p>{comparison.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section final-section" aria-labelledby="final-title">
        <div>
          <p class="eyebrow">Start small</p>
          <h2 id="final-title">Install, initialize, and make drift visible.</h2>
        </div>
        <div class="final-actions">
          <a class="button button-primary" href="/guides/installation/">Install Assura</a>
          <a class="button button-secondary surface" href="/guides/quickstart/">
            Quickstart
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    color-scheme: light;
    --page-bg: #fafafa;
    --page-bg-soft: #f4f4f5;
    --surface: #ffffff;
    --surface-muted: #f5f5f5;
    --text: #18181b;
    --muted: #52525b;
    --soft: #71717a;
    --border: rgba(24, 24, 27, 0.13);
    --border-strong: rgba(24, 24, 27, 0.22);
    --primary: #0f766e;
    --primary-strong: #115e59;
    --primary-soft: rgba(15, 118, 110, 0.1);
    --info: #2563eb;
    --danger: #dc2626;
    --warning: #b45309;
    --shadow: rgba(24, 24, 27, 0.08);
    --hero-text: #101113;
    --hero-muted: #3f3f46;
    --header-bg: rgba(250, 250, 250, 0.82);
    --terminal-bg: #111315;
    --terminal-border: rgba(255, 255, 255, 0.11);
    --terminal-text: #f4f4f5;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      color-scheme: dark;
      --page-bg: #0b0c0d;
      --page-bg-soft: #101213;
      --surface: #111314;
      --surface-muted: #171a1b;
      --text: #f4f4f5;
      --muted: #a1a1aa;
      --soft: #71717a;
      --border: rgba(244, 244, 245, 0.13);
      --border-strong: rgba(244, 244, 245, 0.24);
      --primary: #5eead4;
      --primary-strong: #99f6e4;
      --primary-soft: rgba(94, 234, 212, 0.12);
      --info: #93c5fd;
      --danger: #f87171;
      --warning: #fbbf24;
      --shadow: rgba(0, 0, 0, 0.34);
      --hero-text: #f8fafc;
      --hero-muted: #d4d4d8;
      --header-bg: rgba(11, 12, 13, 0.82);
      --terminal-bg: #08090a;
      --terminal-border: rgba(255, 255, 255, 0.12);
      --terminal-text: #f4f4f5;
    }
  }

  :global(html) {
    min-width: 320px;
    background: var(--page-bg);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background:
      linear-gradient(180deg, transparent 0, var(--page-bg) 42rem),
      var(--page-bg);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  :global(a) {
    color: inherit;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(p),
  :global(code) {
    overflow-wrap: anywhere;
  }

  .skip-link {
    position: fixed;
    z-index: 40;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    border: 1px solid var(--border-strong);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(18px);
  }

  .header-inner,
  .hero-content,
  .section {
    width: min(100% - 2rem, 1120px);
    margin: 0 auto;
  }

  .header-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand,
  .nav-links {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    gap: 0.65rem;
    min-width: 0;
    text-decoration: none;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 1rem;
    font-weight: 800;
  }

  .brand-mark {
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid color-mix(in srgb, var(--primary) 52%, transparent);
    border-radius: 0.45rem;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--primary) 30%, transparent), transparent 58%),
      var(--surface);
    box-shadow: inset 0 0 0 0.32rem var(--primary-soft);
  }

  .nav-links {
    gap: 0.2rem;
    min-width: 0;
  }

  .nav-links a {
    border-radius: 0.45rem;
    padding: 0.52rem 0.68rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links a:hover {
    background: var(--surface-muted);
    color: var(--text);
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.4rem, 5vw, 3.8rem) 0 clamp(1.6rem, 3.5vw, 2.6rem);
  }

  .hero-image {
    position: absolute;
    z-index: -4;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.24;
    filter: grayscale(0.85) saturate(0.35) contrast(1.08);
  }

  .hero-overlay {
    position: absolute;
    z-index: -3;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--page-bg) 74%, transparent), var(--page-bg) 88%),
      color-mix(in srgb, var(--page-bg) 68%, transparent);
  }

  .hero-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--text) 7%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--text) 7%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(180deg, black, transparent 82%);
    opacity: 0.56;
  }

  .hero-content {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--primary);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 15ch;
    margin-bottom: 0;
    color: var(--hero-text);
    font-size: clamp(2.65rem, 5.2vw, 4.75rem);
    font-weight: 720;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .hero-copy {
    max-width: 43rem;
    margin: 1rem auto 0;
    color: var(--hero-muted);
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.62;
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-actions {
    margin-top: 1.3rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.78rem 1rem;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 740;
    line-height: 1;
    white-space: nowrap;
  }

  .button-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 0.8rem 2rem color-mix(in srgb, var(--primary) 20%, transparent);
  }

  .button-primary:hover {
    background: var(--primary-strong);
  }

  .button-secondary {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--text);
    backdrop-filter: blur(14px);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
  }

  @media (prefers-color-scheme: dark) {
    .button-primary {
      color: #06201c;
    }
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.1rem;
    margin: 1rem 0 0;
    padding: 0;
    color: var(--muted);
    list-style: none;
    font-size: 0.9rem;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-facts li::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--primary);
    content: "";
  }

  .command-strip {
    display: grid;
    width: min(100%, 47rem);
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    margin-top: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    padding: 0.68rem 0.78rem;
    box-shadow: 0 1px 2px var(--shadow);
    text-align: left;
    backdrop-filter: blur(16px);
  }

  .command-strip span {
    color: var(--soft);
    font-size: 0.78rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .command-strip code {
    min-width: 0;
    color: var(--text);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .terminal {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--terminal-border);
    border-radius: 0.5rem;
    background: var(--terminal-bg);
    box-shadow: 0 1.25rem 3rem var(--shadow);
    color: var(--terminal-text);
    text-align: left;
  }

  .hero-terminal {
    width: min(100%, 48rem);
    margin-top: 1rem;
  }

  .terminal-bar {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.42rem;
    border-bottom: 1px solid var(--terminal-border);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.72rem 0.85rem;
  }

  .terminal-bar span {
    width: 0.72rem;
    height: 0.72rem;
    flex: 0 0 auto;
    border-radius: 999px;
  }

  .terminal-bar span:nth-child(1) {
    background: var(--danger);
  }

  .terminal-bar span:nth-child(2) {
    background: var(--warning);
  }

  .terminal-bar span:nth-child(3) {
    background: var(--primary);
  }

  .terminal-bar strong {
    min-width: 0;
    margin-left: 0.35rem;
    color: color-mix(in srgb, var(--terminal-text) 70%, transparent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.76rem;
    font-weight: 680;
    overflow-wrap: anywhere;
  }

  .terminal pre {
    margin: 0;
    overflow-x: auto;
    padding: 0.95rem;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .terminal-line {
    display: block;
    min-width: max-content;
    white-space: pre;
  }

  .terminal-line.prompt,
  .terminal-line.pass {
    color: var(--primary);
  }

  .terminal-line.fail {
    color: var(--danger);
  }

  .terminal-line.info {
    color: var(--info);
  }

  .terminal-line.muted {
    color: color-mix(in srgb, var(--terminal-text) 55%, transparent);
  }

  .terminal-line.plain {
    color: var(--terminal-text);
  }

  .section {
