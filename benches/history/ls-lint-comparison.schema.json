{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assura.dev/schemas/assura-performance-v1.json",
  "title": "Assura performance comparison row",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "commit_sha",
    "branch",
    "os",
    "arch",
    "rust_version",
    "node_version",
    "npm_version",
    "assura_version",
    "ls_lint_version",
    "fixture_id",
    "fixture_source_revision",
    "fixture_cohort",
    "rule_cohort",
    "tool_name",
    "median_runtime_ms",
    "distribution",
    "success",
    "status",
    "comparison_baseline_id"
  ],
  "allOf": [
    {
      "if": {
        "required": ["row_family"]
      },
      "then": {
        "required": [
          "legacy_fixture_cohort",
          "row_family",
          "evidence_role",
          "diagnostic",
          "source_type",
          "checked_file_count",
          "ignored_file_count",
          "directory_count",
          "rule_count",
          "rule_surface_summary",
          "native_ls_lint_parity",
          "assura_config_path",
          "ls_lint_config_path",
          "config_generation_method",
          "shared_config_id",
          "expected_assura_exit_status",
          "expected_ls_lint_exit_status",
          "assura_binary_profile",
          "assura_binary_path"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "assura.performance.v1" },
    "timestamp": { "type": "string" },
    "commit_sha": { "type": "string" },
    "branch": { "type": "string" },
    "os": { "type": "string" },
    "arch": { "type": "string" },
    "rust_version": { "type": "string" },
    "node_version": { "type": "string" },
    "npm_version": { "type": "string" },
    "assura_version": { "type": "string" },
    "ls_lint_version": { "type": "string" },
    "fixture_id": { "type": "string" },
    "fixture_source_revision": { "type": "string" },
    "fixture_cohort": { "type": "string" },
    "rule_cohort": { "type": "string" },
    "legacy_fixture_cohort": { "type": "string" },
    "row_family": {
      "anyOf": [
        {
          "enum": [
            "assura-cli",
            "ls-lint-cli",
            "assura-in-process",
            "assura:phase:config-discovery",
            "assura:phase:config-load",
            "assura:phase:checker-init",
            "assura:phase:configured-structure",
            "assura:phase:walk-and-validate",
            "assura:phase:report-sort",
            "traversal:walkdir",
            "traversal:jwalk-serial",
            "traversal:jwalk-parallel"
          ]
        },
        { "type": "string", "pattern": "^strategy:.+" }
      ]
    },
    "evidence_role": { "enum": ["headline-candidate", "diagnostic"] },
    "diagnostic": { "type": "boolean" },
    "source_type": {
      "enum": ["generated", "external-pinned-repo", "materialized-local-fixture"]
    },
    "checked_file_count": { "type": "integer", "minimum": 0 },
    "ignored_file_count": { "type": "integer", "minimum": 0 },
    "directory_count": { "type": "integer", "minimum": 0 },
    "rule_count": { "type": "integer", "minimum": 0 },
    "rule_surface_summary": { "type": "string" },
    "native_ls_lint_parity": { "type": "boolean" },
    "assura_config_path": { "type": "string" },
    "ls_lint_config_path": { "type": "string" },
    "config_generation_method": {
      "enum": [
        "hand-authored-equivalent-pair",
        "hand-authored-external-policy",
        "ls-lint-conversion"
      ]
    },
    "shared_config_id": { "type": "string" },
    "expected_assura_exit_status": { "type": "integer" },
    "expected_ls_lint_exit_status": { "type": "integer" },
    "assura_binary_profile": { "type": ["string", "null"] },
    "assura_binary_path": { "type": ["string", "null"] },
    "tool_name": {
      "anyOf": [
        {
          "enum": [
            "assura",
            "assura-cli",
            "assura-in-process",
            "assura:config-discovery",
            "assura:config-load",
            "assura:checker-init",
            "assura:configured-structure",
            "assura:walk-and-validate",
            "assura:report-sort",
            "assura:phase:config-discovery",
            "assura:phase:config-load",
            "assura:phase:checker-init",
            "assura:phase:configured-structure",
            "assura:phase:walk-and-validate",
            "assura:phase:report-sort",
            "ls-lint",
            "ls-lint-cli",
            "walkdir",
            "jwalk-serial",
            "jwalk-parallel",
            "traversal:walkdir",
            "traversal:jwalk-serial",
            "traversal:jwalk-parallel",
            "walkdir-before-jwalk",
            "jwalk-after-migration"
          ]
        },
        { "type": "string", "pattern": "^strategy:.+" }
      ]
    },
    "median_runtime_ms": { "type": ["number", "null"], "minimum": 0 },
    "distribution": {
      "type": "object",
      "required": ["samples", "samples_ms", "min_ms", "max_ms"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "samples_ms": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "min_ms": { "type": ["number", "null"], "minimum": 0 },
        "max_ms": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "success": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "skipped"] },
    "details": { "type": ["string", "null"] },
    "comparison_baseline_id": { "type": "string" }
  },
  "additionalProperties": false
}
