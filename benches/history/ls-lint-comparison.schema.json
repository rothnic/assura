{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assura.dev/schemas/assura-performance-v1.json",
  "title": "Assura performance comparison row",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "commit_sha",
    "branch",
    "os",
    "arch",
    "rust_version",
    "node_version",
    "npm_version",
    "assura_version",
    "ls_lint_version",
    "fixture_id",
    "fixture_source_revision",
    "fixture_cohort",
    "rule_cohort",
    "tool_name",
    "median_runtime_ms",
    "distribution",
    "success",
    "status",
    "comparison_baseline_id"
  ],
  "allOf": [
    {
      "if": {
        "required": ["row_family"]
      },
      "then": {
        "required": [
          "legacy_fixture_cohort",
          "row_family",
          "validation_execution_mode",
          "evidence_role",
          "diagnostic",
          "source_type",
          "checked_file_count",
          "ignored_file_count",
          "directory_count",
          "rule_count",
          "rule_surface_summary",
          "native_ls_lint_parity",
          "assura_config_path",
          "ls_lint_config_path",
          "config_generation_method",
          "shared_config_id",
          "expected_assura_exit_status",
          "expected_ls_lint_exit_status",
          "assura_binary_profile",
          "assura_binary_path"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "assura.performance.v1" },
    "timestamp": { "type": "string" },
    "commit_sha": { "type": "string" },
    "branch": { "type": "string" },
    "os": { "type": "string" },
    "arch": { "type": "string" },
    "cpu_model": { "type": "string" },
    "logical_cpu_count": { "type": "integer", "minimum": 1 },
    "total_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "rust_version": { "type": "string" },
    "node_version": { "type": "string" },
    "npm_version": { "type": "string" },
    "assura_version": { "type": "string" },
    "ls_lint_version": { "type": "string" },
    "fixture_id": { "type": "string" },
    "fixture_source_revision": { "type": "string" },
    "fixture_cohort": { "type": "string" },
    "rule_cohort": { "type": "string" },
    "legacy_fixture_cohort": { "type": "string" },
    "row_family": {
      "anyOf": [
        {
          "enum": [
            "assura-cli",
            "assura-check-cli",
            "assura-check-cached-cli",
            "assura-check-compiled-cli",
            "assura-check-hot-cli",
            "assura-check-changed-path-cli",
            "assura-check-dirty-project-cli",
            "assura-check-dirty-project-session-cli",
            "assura-check-dirty-project-socket",
            "assura-prepared-full-check",
            "assura-prepared-five-changed-paths",
            "assura-check-status-cli",
            "assura-rust-cli-floor",
            "ls-lint-cli",
            "assura-in-process",
            "process-floor",
            "assura:phase:config-discovery",
            "assura:phase:config-load",
            "assura:phase:checker-init",
            "assura:phase:configured-structure",
            "assura:phase:walk-and-validate",
            "assura:phase:report-sort",
            "traversal:walkdir",
            "traversal:jwalk-serial",
            "traversal:jwalk-parallel"
          ]
        },
        { "type": "string", "pattern": "^strategy:.+" }
      ]
    },
    "evidence_role": { "enum": ["headline-candidate", "diagnostic"] },
    "validation_execution_mode": {
      "enum": [
        "cold-cli",
        "warm-cache-cli",
        "precompiled-config-cli",
        "hot-daemon-cli",
        "hot-daemon-changed-path-cli",
        "hot-daemon-dirty-project-cli",
        "hot-daemon-dirty-project-session-cli",
        "hot-daemon-dirty-project-socket",
        "prepared-full-project-check",
        "prepared-scoped-changed-paths",
        "status-file-cli",
        "rust-cli-floor",
        "in-process",
        "process-floor",
        "phase-timing",
        "traversal-only",
        "diagnostic-strategy-cli",
        "diagnostic"
      ]
    },
    "diagnostic": { "type": "boolean" },
    "source_type": {
      "enum": [
        "generated",
        "external-pinned-repo",
        "materialized-local-fixture",
        "checked-repo-fixture"
      ]
    },
    "checked_file_count": { "type": "integer", "minimum": 0 },
    "ignored_file_count": { "type": "integer", "minimum": 0 },
    "directory_count": { "type": "integer", "minimum": 0 },
    "rule_count": { "type": "integer", "minimum": 0 },
    "rule_surface_summary": { "type": "string" },
    "native_ls_lint_parity": { "type": "boolean" },
    "assura_config_path": { "type": "string" },
    "ls_lint_config_path": { "type": "string" },
    "config_generation_method": {
      "enum": [
        "hand-authored-equivalent-pair",
        "hand-authored-external-policy",
        "assura-native-policy-fixture",
        "external-ls-lint-conversion",
        "ls-lint-conversion"
      ]
    },
    "shared_config_id": { "type": "string" },
    "expected_assura_exit_status": { "type": "integer" },
    "expected_ls_lint_exit_status": { "type": "integer" },
    "assura_binary_profile": { "type": ["string", "null"] },
    "assura_binary_path": { "type": ["string", "null"] },
    "ls_lint_binary_path": { "type": ["string", "null"] },
    "ls_lint_execution_mode": {
      "enum": ["native-binary-from-pinned-npm-package", null]
    },
    "tool_name": {
      "anyOf": [
        {
          "enum": [
            "assura",
            "assura-cli",
            "assura-check-cli",
            "assura-check-cached-cli",
            "assura-check-compiled-cli",
            "assura-check-hot-cli",
            "assura-check-changed-path-cli",
            "assura-check-dirty-project-cli",
            "assura-check-dirty-project-session-cli",
            "assura-check-dirty-project-socket",
            "assura-prepared-full-check",
            "assura-prepared-five-changed-paths",
            "assura-check-status-cli",
            "assura-rust-cli-floor",
            "assura-in-process",
            "process-floor",
            "assura:config-discovery",
            "assura:config-load",
            "assura:checker-init",
            "assura:configured-structure",
            "assura:walk-and-validate",
            "assura:report-sort",
            "assura:phase:config-discovery",
            "assura:phase:config-load",
            "assura:phase:checker-init",
            "assura:phase:configured-structure",
            "assura:phase:walk-and-validate",
            "assura:phase:report-sort",
            "ls-lint",
            "ls-lint-cli",
            "ls-lint-native-cli",
            "walkdir",
            "jwalk-serial",
            "jwalk-parallel",
            "traversal:walkdir",
            "traversal:jwalk-serial",
            "traversal:jwalk-parallel",
            "walkdir-before-jwalk",
            "jwalk-after-migration"
          ]
        },
        { "type": "string", "pattern": "^strategy:.+" }
      ]
    },
    "median_runtime_ms": { "type": ["number", "null"], "minimum": 0 },
    "p95_runtime_ms": { "type": ["number", "null"], "minimum": 0 },
    "two_x_target_runtime_ms": { "type": ["number", "null"], "minimum": 0 },
    "process_floor_runtime_ms": { "type": ["number", "null"], "minimum": 0 },
    "process_floor_to_two_x_target_ratio": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "process_floor_blocks_two_x": { "type": ["boolean", "null"] },
    "rust_cli_floor_runtime_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "rust_cli_floor_to_two_x_target_ratio": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "rust_cli_floor_blocks_two_x": { "type": ["boolean", "null"] },
    "runtime_above_process_floor_ms": {
      "type": ["number", "null"]
    },
    "assura_cli_overhead_ms": {
      "type": ["number", "null"]
    },
    "runtime_to_two_x_target_ratio": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "meets_two_x_target": { "type": ["boolean", "null"] },
    "two_x_claim_status": {
      "enum": [
        "meets-target",
        "blocked-by-process-floor",
        "blocked-by-rust-cli-floor",
        "misses-target",
        null
      ]
    },
    "proves_whole_project_success": { "type": "boolean" },
    "changed_path_count": { "type": ["integer", "null"], "minimum": 1 },
    "latency_threshold_ms": { "type": ["number", "null"], "minimum": 0 },
    "latency_threshold_met": { "type": ["boolean", "null"] },
    "native_regression_baseline_median_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "native_regression_baseline_report_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "native_regression_baseline_sample_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "native_regression_threshold_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "native_regression_delta_ms": { "type": ["number", "null"] },
    "native_regression_status": {
      "enum": [
        "within-calibrated-baseline",
        "regressed-vs-calibrated-baseline",
        "within-provisional-baseline",
        "regressed-vs-provisional-baseline",
        "baseline-missing",
        "baseline-row-missing",
        "baseline-row-unusable",
        null
      ]
    },
    "distribution": {
      "type": "object",
      "required": ["samples", "samples_ms", "min_ms", "max_ms"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "p95_ms": { "type": ["number", "null"], "minimum": 0 },
        "samples_ms": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "min_ms": { "type": ["number", "null"], "minimum": 0 },
        "max_ms": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "success": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "skipped"] },
    "details": { "type": ["string", "null"] },
    "comparison_baseline_id": { "type": "string" }
  },
  "additionalProperties": false
}
