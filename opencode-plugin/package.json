{
  "name": "@assura/opencode-plugin",
  "version": "0.1.0",
  "description": "OpenCode plugin for Assura constraint validation - integrate file system validation into your IDE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "assura",
    "opencode",
    "constraints",
    "validation",
    "linting",
    "filesystem",
    "naming-conventions"
  ],
  "author": "Assura Team <team@assura.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/assura/assura.git",
    "directory": "opencode-plugin"
  },
  "homepage": "https://assura.dev",
  "bugs": {
    "url": "https://github.com/assura/assura/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
