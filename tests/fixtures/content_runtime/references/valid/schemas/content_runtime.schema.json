{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assura.dev/examples/content-runtime-references.schema.json",
  "$defs": {
    "Goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["planned", "active", "complete"] },
        "specs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "active", "complete"] },
        "decision": { "type": "string", "minLength": 1 }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "accepted"] },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "related": { "type": "string", "minLength": 1 },
        "parent": { "type": "string", "minLength": 1 }
      }
    }
  }
}
