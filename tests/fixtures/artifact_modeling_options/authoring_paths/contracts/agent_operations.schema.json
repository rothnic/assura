{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assura.dev/runtime/agent-operations.schema.json",
  "title": "Assura Agent Artifact Operations",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "task"],
      "properties": {
        "op": {
          "const": "create_task"
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "goal_id", "task_id"],
      "properties": {
        "op": {
          "const": "append_goal_task"
        },
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "$defs": {
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "goal", "priority", "metadata"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "complete", "deprecated"]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": ["p0", "p1", "p2"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "metadata": {
          "$ref": "#/$defs/ArtifactMetadata"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["file", "url"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ArtifactMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "risk"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
